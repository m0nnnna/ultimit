// Ultimit FIREWALL: reading the firewall state (firewall-helper status) needs no password for an
// admin sitting at this computer, so the window can show the rules and blocked connections.
// Every change still asks (org.ultimit.firewall is auth_admin_keep).
polkit.addRule(function(action, subject) {
    if (action.id == "org.ultimit.firewall" && subject.local && subject.active &&
        (subject.isInGroup("sudo") || subject.isInGroup("admin")) &&
        action.lookup("command_line") == "/usr/libexec/ultimit/firewall-helper status") {
        return polkit.Result.YES;
    }
});
