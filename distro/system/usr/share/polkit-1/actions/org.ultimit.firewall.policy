<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Ultimit FIREWALL: the root helper that reads and changes ufw rules (see firewall-helper). -->
<policyconfig>
  <vendor>Ultimit</vendor>
  <action id="org.ultimit.firewall">
    <description>Manage the firewall</description>
    <message>Authentication is required to change which devices can reach this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ultimit/firewall-helper</annotate>
  </action>
</policyconfig>
