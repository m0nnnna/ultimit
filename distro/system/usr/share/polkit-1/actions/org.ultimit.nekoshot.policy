<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Ultimit BACKUP: the root helper that runs NekoShot system backups (see nekoshot-helper). -->
<policyconfig>
  <vendor>Ultimit</vendor>
  <action id="org.ultimit.nekoshot">
    <description>Back up and manage system backups</description>
    <message>Authentication is required to back up or manage backups of this computer</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/ultimit/nekoshot-helper</annotate>
  </action>
</policyconfig>
