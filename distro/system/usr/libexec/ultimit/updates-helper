#!/usr/bin/python3 -I
"""updates-helper - the only part of Settings > Updates that runs as root (through pkexec).

  updates-helper refresh    apt-get update (fetch the package lists)
  updates-helper upgrade    install every pending system update: apt-get --with-new-pkgs upgrade,
                            never removes packages, keeps changed config files
  updates-helper ultimit TAG
                            install that Ultimit release from GitHub (the repository in
                            /opt/ultimit/distro/update-source): download, check its SHA256, run the
                            release's own scripts/system-install.sh --release. If that fails, the
                            previous /opt/ultimit comes back. Log: /var/log/ultimit-update.log
                            (sudo UPDATES_RELEASE_BASE=URL ... downloads from URL/ instead: testing)

Prints JSON lines while it works: {"stage": "...", "pct": 0..100, "msg": "..."}, then one final
{"ok": true} or {"ok": false, "error": "..."}. Waits up to 5 minutes for apt's lock (the
automatic updates may be running).

Polkit action org.ultimit.updates (auth_admin_keep); `refresh` alone is allowed without a
password for local, active admins (rules.d/50-ultimit-updates.rules).
"""
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import tarfile
import tempfile
import time
import urllib.request

_dev = os.getuid() != 0
APT_GET = (_dev and os.environ.get("UPDATES_APT_GET")) or "/usr/bin/apt-get"

COMMON = ["-q", "-o", "APT::Status-Fd=1", "-o", "DPkg::Lock::Timeout=300"]
UPGRADE = ["-y", "--with-new-pkgs", "-o", "Dpkg::Options::=--force-confdef",
           "-o", "Dpkg::Options::=--force-confold", "upgrade"]


def emit(o):
    # Settings may go away mid-update (its files are being replaced): carry on without it.
    try:
        sys.stdout.write(json.dumps(o) + "\n")
        sys.stdout.flush()
    except (BrokenPipeError, OSError, ValueError):
        pass


def apt(args, stage):
    env = dict(os.environ, LC_ALL="C", DEBIAN_FRONTEND="noninteractive", APT_LISTCHANGES_FRONTEND="none")
    try:
        p = subprocess.Popen([APT_GET] + COMMON + args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                             stdin=subprocess.DEVNULL, text=True, env=env)
    except FileNotFoundError:
        return False, "apt-get not found"
    last = ""   # apt's last error line ("E: ..."), or its last plain line
    for line in p.stdout:
        line = line.rstrip("\n")
        # Status-Fd lines: dlstatus:N:PCT:TEXT / pmstatus:PKG:PCT:TEXT / pmerror:PKG:PCT:TEXT
        kind, _, rest = line.partition(":")
        if kind in ("dlstatus", "pmstatus", "pmerror", "pmconffile"):
            f = rest.split(":", 2)
            try:
                pct = float(f[1]) if len(f) > 1 else 0.0
            except ValueError:
                pct = 0.0
            msg = f[2] if len(f) > 2 else ""
            if kind == "pmerror":
                last = msg
            emit({"stage": "download" if kind == "dlstatus" else stage, "pct": round(pct, 1), "msg": msg})
        elif line.strip() and (line.startswith("E:") or not last.startswith("E:")):
            last = line.strip()
    rc = p.wait()
    if rc != 0:
        return False, last or "apt-get failed (exit %d)" % rc
    return True, ""


PREFIX = "/opt/ultimit"
UPDATE_LOG = "/var/log/ultimit-update.log"
RUNNING = "/run/ultimit-update.running"   # holds the pid while an update runs (updates.py reads it)
TAG_RE = re.compile(r"^v?\d+(\.\d+){1,3}$")
REPO_RE = re.compile(r"^[\w.-]+/[\w.-]+$")
DEFAULT_REPO = "m0nnnna/ultimit"   # installs older than distro/update-source


def update_source():
    # Root-owned (installed with Ultimit), never taken from the caller
    try:
        with open(os.path.join(PREFIX, "distro/update-source")) as f:
            for line in f:
                line = line.split("#")[0].strip()
                if REPO_RE.match(line):
                    return line
    except OSError:
        return DEFAULT_REPO
    return ""


def fetch(url, dest, label):
    req = urllib.request.Request(url, headers={"User-Agent": "ultimit-updates"})
    with urllib.request.urlopen(req, timeout=60) as r, open(dest, "wb") as f:
        total = int(r.headers.get("Content-Length") or 0)
        got, last = 0, 0.0
        while True:
            b = r.read(1 << 16)
            if not b:
                break
            f.write(b)
            got += len(b)
            if total and time.monotonic() - last > 0.3:
                last = time.monotonic()
                emit({"stage": "download", "pct": round(100 * got / total, 1),
                      "msg": "%s  %d / %d MB" % (label, got >> 20, total >> 20)})


def ultimit(tag):
    if not TAG_RE.match(tag):
        return False, "not a release version: %r" % tag
    repo = update_source()
    if not repo:
        return False, "no update source in %s/distro/update-source" % PREFIX
    ver = tag[1:] if tag.startswith("v") else tag
    name = "ultimit-%s-amd64.tar.gz" % ver
    base = "https://github.com/%s/releases/download/%s/" % (repo, tag)
    # Testing a release before publishing it (root only: pkexec clears the environment)
    if os.getuid() == 0 and os.environ.get("UPDATES_RELEASE_BASE"):
        base = os.environ["UPDATES_RELEASE_BASE"].rstrip("/") + "/"
    work = tempfile.mkdtemp(prefix="ultimit-update-", dir="/var/tmp")
    try:
        emit({"stage": "download", "pct": 0, "msg": "Downloading Ultimit " + ver})
        try:
            fetch(base + name + ".sha256", os.path.join(work, "sum"), "checksum")
            fetch(base + name, os.path.join(work, name), name)
        except OSError as e:
            return False, "download failed: %s" % getattr(e, "reason", e)
        with open(os.path.join(work, "sum")) as f:
            want = (f.read().split() or [""])[0].lower()
        h = hashlib.sha256()
        with open(os.path.join(work, name), "rb") as f:
            for b in iter(lambda: f.read(1 << 20), b""):
                h.update(b)
        if not re.match(r"^[0-9a-f]{64}$", want) or h.hexdigest() != want:
            return False, "the download doesn't match its checksum"
        # This release's own installer does the work
        script = "opt/ultimit/scripts/system-install.sh"
        try:
            with tarfile.open(os.path.join(work, name)) as t:
                t.extract(t.getmember(script), work, filter="data")
        except (KeyError, tarfile.TarError, OSError):
            return False, "%s isn't an Ultimit release" % name
        args = [os.path.join(work, script), "--release", os.path.join(work, name), "--apps-new"]
        dm = os.path.realpath("/etc/systemd/system/display-manager.service")
        if os.path.basename(dm) != "greetd.service":
            args.append("--keep-login-screen")   # this PC uses another login screen: leave it
        shutil.rmtree(PREFIX + ".previous", ignore_errors=True)
        steps = ["Unpacking", "Installing the packages", "Setting up the system", "Making the Ultimit login", "Checking"]
        last = ""
        with open(UPDATE_LOG, "a") as log:
            log.write("\n==== %s  Ultimit %s from %s\n" % (time.strftime("%Y-%m-%d %H:%M:%S"), ver, repo))
            log.flush()
            env = dict(os.environ, LC_ALL="C", DEBIAN_FRONTEND="noninteractive")
            p = subprocess.Popen(args, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, stdin=subprocess.DEVNULL,
                                 text=True, errors="replace", env=env)
            for line in p.stdout:
                log.write(line)
                log.flush()
                t = re.sub(r"\x1b\[[0-9;]*m", "", line).strip()
                if t.startswith("== "):
                    n = next((i for i, s in enumerate(steps) if t[3:].startswith(s)), -1)
                    emit({"stage": "install", "pct": round(100 * (n + 1) / (len(steps) + 1)) if n >= 0 else -1, "msg": t[3:]})
                elif t:
                    last = t
            rc = p.wait()
        if rc != 0:
            # Put the previous Ultimit back (system-install.sh keeps it until it has finished)
            if os.path.isdir(PREFIX + ".previous"):
                shutil.rmtree(PREFIX, ignore_errors=True)
                os.rename(PREFIX + ".previous", PREFIX)
                last += " (the previous version was put back)"
            return False, (last or "the install failed (exit %d)" % rc) + "; see " + UPDATE_LOG
        emit({"stage": "install", "pct": 100, "msg": "Ultimit %s installed" % ver})
        return True, ""
    finally:
        shutil.rmtree(work, ignore_errors=True)


def main(argv):
    cmd = argv[1] if len(argv) >= 2 else ""
    if cmd == "refresh":
        ok, e = apt(["update"], "refresh")
    elif cmd == "upgrade":
        ok, e = apt(UPGRADE, "install")
    elif len(argv) == 3 and argv[1] == "ultimit":
        signal.signal(signal.SIGHUP, signal.SIG_IGN)   # finish even if Settings closes
        lock = open("/run/ultimit-update.lock", "w")
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except OSError:
            emit({"ok": False, "error": "An Ultimit update is already running."})
            return 1
        with open(RUNNING, "w") as f:
            f.write(str(os.getpid()))
        try:
            ok, e = ultimit(argv[2])
        finally:
            try:
                os.unlink(RUNNING)
            except OSError:
                pass
    else:
        emit({"ok": False, "error": "usage: updates-helper refresh|upgrade|ultimit TAG"})
        return 2
    emit({"ok": True} if ok else {"ok": False, "error": e})
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
