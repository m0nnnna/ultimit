#!/usr/bin/python3 -I
"""firewall-helper - the only part of Ultimit FIREWALL that runs as root (through pkexec).

Small on purpose: it reads ufw's state and applies rule changes it validated itself, nothing else.
All parsing for the UI happens unprivileged in shell/apps/firewall/firewall.py.

  firewall-helper status            ufw status, its rules (`ufw show added`) and recent [UFW BLOCK] kernel log lines
  firewall-helper enable|disable    turn ufw on / off
  firewall-helper apply             JSON on stdin: {"add": [{port, proto, from, comment}], "remove": ["<rule line>"]}
                                    a removed rule must be a line of `ufw show added`, exactly as `status` printed it

Polkit action org.ultimit.firewall (auth_admin_keep); `status` alone is allowed without a password for
local, active admins (rules.d/50-ultimit-firewall.rules). Every command prints one JSON object.
"""
import ipaddress
import json
import os
import re
import shlex
import subprocess
import sys

# Overrides only for tests run as a normal user; pkexec clears the environment anyway.
_dev = os.getuid() != 0
UFW = (_dev and os.environ.get("FIREWALL_UFW")) or "/usr/sbin/ufw"
JOURNALCTL = (_dev and os.environ.get("FIREWALL_JOURNALCTL")) or "/usr/bin/journalctl"

PORT_RE = re.compile(r"^\d{1,5}(:\d{1,5})?(,\d{1,5}(:\d{1,5})?){0,14}$")
COMMENT_RE = re.compile(r"^[A-Za-z0-9 ._:()/+&-]{0,60}$")
LOG_LINES = 400


def out(o, rc=0):
    sys.stdout.write(json.dumps(o))
    sys.stdout.flush()
    return rc


def run(argv, timeout=30):
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout, p.stderr
    except FileNotFoundError:
        return 127, "", "%s: not found" % argv[0]
    except subprocess.TimeoutExpired:
        return 124, "", "%s: timed out" % argv[0]


def fail_text(rc, o, e):
    lines = (e or o).strip().splitlines()
    return lines[-1] if lines else "ufw failed (exit %d)" % rc


def check_port(port, proto):
    if not PORT_RE.match(port or ""):
        return "bad port: %r" % port
    for part in port.split(","):
        nums = [int(x) for x in part.split(":")]
        if any(n < 1 or n > 65535 for n in nums) or (len(nums) == 2 and nums[0] >= nums[1]):
            return "bad port: %r" % port
    if proto not in ("tcp", "udp", "any"):
        return "bad protocol: %r" % proto
    if proto == "any" and re.search(r"[:,]", port):
        return "port ranges and lists need tcp or udp"
    return None


def add_argv(r):
    port, proto, src, comment = str(r.get("port", "")), r.get("proto", "any"), r.get("from", ""), r.get("comment", "")
    err = check_port(port, proto)
    if err:
        return None, err
    if src != "any":
        try:
            src = str(ipaddress.ip_network(src, strict=False))
        except ValueError:
            return None, "bad source: %r" % src
    if not isinstance(comment, str) or not COMMENT_RE.match(comment):
        return None, "bad comment: %r" % comment
    argv = [UFW, "allow", "from", src, "to", "any", "port", port]
    if proto != "any":
        argv += ["proto", proto]
    if comment:
        argv += ["comment", comment]
    return argv, None


def added_lines():
    rc, o, e = run([UFW, "show", "added"])
    if rc != 0:
        return None, fail_text(rc, o, e)
    return [l.strip() for l in o.splitlines() if l.strip().startswith("ufw ")], None


def remove_argv(line, current):
    """Only a rule ufw itself listed can be removed; its tokens come from ufw's own output."""
    if line not in current:
        return None, "That rule is no longer there."
    toks = shlex.split(line)[1:]
    if "comment" in toks:
        toks = toks[:toks.index("comment")]
    return [UFW, "delete"] + toks, None


def status():
    rc, verbose, e = run([UFW, "status", "verbose"])
    if rc == 127:
        return out({"ok": True, "installed": False})
    if rc != 0:
        return out({"ok": False, "error": fail_text(rc, verbose, e)}, 1)
    lines, err = added_lines()
    if lines is None:
        return out({"ok": False, "error": err}, 1)
    log = []
    rc, o, _ = run([JOURNALCTL, "-k", "-q", "--no-pager", "-o", "short-unix", "--since=-30min"])
    if rc == 0:
        log = [l for l in o.splitlines() if "[UFW BLOCK]" in l][-LOG_LINES:]
    return out({"ok": True, "installed": True, "verbose": verbose, "added": lines, "log": log, "logOk": rc == 0})


def apply(req):
    if not isinstance(req, dict):
        return out({"ok": False, "error": "bad request"}, 2)
    adds, removes = req.get("add") or [], req.get("remove") or []
    if not isinstance(adds, list) or not isinstance(removes, list) or len(adds) + len(removes) > 64:
        return out({"ok": False, "error": "bad request"}, 2)
    current, err = added_lines()
    if current is None:
        return out({"ok": False, "error": err}, 1)
    plan = []
    for line in removes:
        argv, err = remove_argv(line, current) if isinstance(line, str) else (None, "bad rule")
        if err:
            return out({"ok": False, "error": err}, 2)
        plan.append(argv)
    for r in adds:
        argv, err = add_argv(r) if isinstance(r, dict) else (None, "bad rule")
        if err:
            return out({"ok": False, "error": err}, 2)
        plan.append(argv)
    done = 0
    for argv in plan:   # validated as a whole first, so a bad request changes nothing
        rc, o, e = run(argv)
        if rc != 0:
            return out({"ok": False, "error": fail_text(rc, o, e), "done": done}, 1)
        done += 1
    return out({"ok": True, "done": done})


def main(argv):
    cmd = argv[0] if argv else ""
    if cmd == "status" and len(argv) == 1:
        return status()
    if cmd in ("enable", "disable") and len(argv) == 1:
        rc, o, e = run([UFW, "--force", "enable"] if cmd == "enable" else [UFW, "disable"])
        return out({"ok": True}) if rc == 0 else out({"ok": False, "error": fail_text(rc, o, e)}, 1)
    if cmd == "apply" and len(argv) == 1:
        try:
            req = json.loads(sys.stdin.read(65536))
        except ValueError:
            return out({"ok": False, "error": "bad request"}, 2)
        return apply(req)
    return out({"ok": False, "error": "usage: firewall-helper status|enable|disable|apply"}, 2)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
