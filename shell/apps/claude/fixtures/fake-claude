#!/usr/bin/env python3
"""fake-claude - stands in for the Claude Code CLI in test_claude.py (ULTIMIT_CLAUDE_BIN). Speaks the same
stream-json shapes the real `claude -p --input-format stream-json --output-format stream-json` does
(captured from Claude Code 2.1.300), and keeps its "login" in $CLAUDE_CONFIG_DIR/.credentials.json.

A prompt containing "write" asks to use the Write tool (a can_use_tool control request) and reports
what the host answered; any other prompt gets a plain answer that names the config dir in use and
whether a credential leaked in through the environment."""
import json
import os
import sys
import uuid

cfg = os.environ.get("CLAUDE_CONFIG_DIR") or os.path.join(os.path.expanduser("~"), ".claude")
creds = os.path.join(cfg, ".credentials.json")


def out(o):
    sys.stdout.write(json.dumps(o) + "\n")
    sys.stdout.flush()


a = sys.argv[1:]
if a[:1] == ["--version"]:
    print("9.9.9 (Claude Code)")
    sys.exit(0)
if a[:2] == ["auth", "status"]:
    ok = os.path.exists(creds)
    print(json.dumps({"loggedIn": ok, "authMethod": "claude.ai" if ok else "none", "configDirectory": cfg,
                      **({"account": {"emailAddress": "noc@example.com"}} if ok else {})}, indent=2))
    sys.exit(0 if ok else 1)
if a[:2] == ["auth", "logout"]:
    if os.path.exists(creds):
        os.unlink(creds)
    print("Successfully logged out")
    sys.exit(0)
if a[:2] == ["auth", "login"]:
    print("Opening browser to sign in…")
    print("If the browser didn't open, visit: https://claude.com/cai/oauth/authorize?code=true&state=x")
    sys.stdout.write("Paste code here if prompted > ")
    sys.stdout.flush()
    code = sys.stdin.readline().strip()
    if code != "good-code":
        print("\nLogin failed: invalid code")
        sys.exit(1)
    os.makedirs(cfg, exist_ok=True)
    with open(creds, "w") as f:
        f.write("{}")
    print("\nLogin successful")
    sys.exit(0)

if "-p" not in a:
    sys.exit(2)
session = a[a.index("--resume") + 1] if "--resume" in a else str(uuid.uuid4())
# Like the real CLI: the transcript lives in the config dir, and --resume needs it there
transcript = os.path.join(cfg, "projects", "".join(c if c.isalnum() else "-" for c in os.getcwd()), session + ".jsonl")
if "--resume" in a and not os.path.exists(transcript):
    out({"type": "result", "subtype": "error_during_execution", "is_error": True, "session_id": session,
         "result": "No conversation found with session ID: " + session})
    sys.exit(1)
mode = a[a.index("--permission-mode") + 1] if "--permission-mode" in a else "default"
if not os.path.exists(creds):
    pass  # the real CLI reports this as the result of the first turn
inited = False
turns = 0
pending = None
for line in sys.stdin:
    m = json.loads(line)
    if m.get("type") == "control_request":
        sub = m["request"]["subtype"]
        out({"type": "control_response", "response": {"subtype": "success", "request_id": m["request_id"], "response": {}}})
        if sub == "interrupt":
            out({"type": "result", "subtype": "error_during_execution", "is_error": True, "session_id": session,
                 "result": "Interrupted", "total_cost_usd": 0})
        continue
    if m.get("type") == "control_response":
        r = m["response"]["response"]
        allowed = r.get("behavior") == "allow"
        out({"type": "user", "parent_tool_use_id": None, "session_id": session, "message": {"role": "user", "content": [
            {"type": "tool_result", "tool_use_id": "toolu_1", "is_error": not allowed,
             "content": "File created successfully" if allowed else r.get("message", "denied")}]}})
        answers = (r.get("updatedInput") or {}).get("answers")
        out({"type": "assistant", "parent_tool_use_id": None, "session_id": session, "message": {"role": "assistant", "content": [
            {"type": "text", "text": ("answers=" + json.dumps(answers, sort_keys=True)) if answers
             else "Wrote it." if allowed else "Not written."}]}})
        out({"type": "result", "subtype": "success", "is_error": False, "session_id": session, "num_turns": 2,
             "total_cost_usd": 0.01, "duration_ms": 1200, "result": "", "permission_denials": [] if allowed else [{}]})
        continue
    if m.get("type") != "user":
        continue
    if not inited:
        inited = True
        out({"type": "system", "subtype": "init", "session_id": session, "model": "claude-test-1",
             "permissionMode": mode, "claude_code_version": "9.9.9", "cwd": os.getcwd()})
    if not os.path.exists(creds):
        out({"type": "result", "subtype": "success", "is_error": True, "session_id": session,
             "result": "Not logged in · Please run /login"})
        continue
    text = m["message"]["content"]
    images = 0
    if isinstance(text, list):          # image blocks first, then the text (when there is any)
        images = sum(1 for b in text if b.get("type") == "image" and b["source"]["type"] == "base64" and b["source"]["data"])
        text = "".join(b.get("text", "") for b in text if b.get("type") == "text")
    os.makedirs(os.path.dirname(transcript), exist_ok=True)
    with open(transcript, "a") as f:
        f.write(json.dumps({"prompt": text}) + "\n")
    out({"type": "system", "subtype": "task_summary", "detail": "Thinking it over", "session_id": session})
    if "question" in text.lower():
        q = {"questions": [{"question": "Which colour?", "header": "Colour", "multiSelect": False,
                            "options": [{"label": "Red", "description": "warm"}, {"label": "Blue", "description": "cool"}]},
                           {"question": "Which sides?", "header": "Sides", "multiSelect": True,
                            "options": [{"label": "Left", "description": ""}, {"label": "Right", "description": ""}]}]}
        out({"type": "assistant", "parent_tool_use_id": None, "session_id": session, "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "toolu_1", "name": "AskUserQuestion", "input": q}]}})
        out({"type": "control_request", "request_id": "req-1", "request": {
            "subtype": "can_use_tool", "tool_name": "AskUserQuestion", "input": q, "tool_use_id": "toolu_1"}})
        continue
    if "write" in text.lower():
        out({"type": "assistant", "parent_tool_use_id": None, "session_id": session, "message": {"role": "assistant", "content": [
            {"type": "tool_use", "id": "toolu_1", "name": "Write", "input": {"file_path": "/tmp/x/hello.txt", "content": "hi"}}]}})
        out({"type": "control_request", "request_id": "req-1", "request": {
            "subtype": "can_use_tool", "tool_name": "Write", "display_name": "Write",
            "input": {"file_path": "/tmp/x/hello.txt", "content": "hi"}, "description": "hello.txt",
            "permission_suggestions": [{"type": "setMode", "mode": "acceptEdits", "destination": "session"}],
            "tool_use_id": "toolu_1"}})
        continue
    leaked = [k for k in ("ANTHROPIC_API_KEY", "CLAUDE_CODE_OAUTH_TOKEN") if k in os.environ]
    reply = "config=%s leaked=%s sysinfo=%s cwd=%s" % (cfg, ",".join(leaked) or "none",
                                                       "<system-summary>" in text, os.getcwd())
    if images:
        reply += " images=%d" % images
    if "compact" in text.lower():       # the context filled: Claude Code compacts by itself
        out({"type": "system", "subtype": "status", "status": "compacting", "session_id": session})
        out({"type": "system", "subtype": "compact_boundary", "session_id": session,
             "compact_metadata": {"trigger": "auto", "pre_tokens": 167000}})
        reply += " window=%s autocompact=%s" % (os.environ.get("CLAUDE_CODE_AUTO_COMPACT_WINDOW", "auto"),
                                                "off" if os.environ.get("DISABLE_AUTO_COMPACT") else "on")
    if "subagent" in text.lower():
        sp = a[a.index("--append-system-prompt") + 1] if "--append-system-prompt" in a else ""
        agents = json.loads(a[a.index("--agents") + 1]) if "--agents" in a else {}
        reply += " agents=%s effort=%s scaling=%s model=%s" % (
            ",".join(sorted(agents)), a[a.index("--effort") + 1] if "--effort" in a else "", '"expert"' in sp,
            a[a.index("--model") + 1] if "--model" in a else "")
    for i in range(0, len(reply), 8):
        out({"type": "stream_event", "parent_tool_use_id": None, "session_id": session,
             "event": {"type": "content_block_delta", "index": 0, "delta": {"type": "text_delta", "text": reply[i:i + 8]}}})
    out({"type": "assistant", "parent_tool_use_id": None, "session_id": session, "message": {"role": "assistant", "content": [
        {"type": "text", "text": reply}]}})
    turns += 1
    out({"type": "rate_limit_event", "session_id": session, "rate_limit_info": {
        "status": "allowed", "resetsAt": 1792119600, "rateLimitType": "five_hour", "isUsingOverage": False,
        "unifiedWindows": {"five_hour": {"utilization": 0.1 * turns, "resetsAt": 1792119600},
                           "seven_day": {"utilization": 0.41, "resetsAt": 1792263600}}}})
    # total_cost_usd and modelUsage are running totals for the process; usage is this turn's
    out({"type": "result", "subtype": "success", "is_error": False, "session_id": session, "num_turns": 1,
         "total_cost_usd": 0.002 * turns, "duration_ms": 900, "result": reply, "permission_denials": [],
         "usage": {"input_tokens": 2, "output_tokens": 30, "cache_read_input_tokens": 1000 * turns,
                   "cache_creation_input_tokens": 500},
         "modelUsage": {"claude-test-1": {"outputTokens": 30 * turns, "costUSD": 0.002 * turns,
                                          "contextWindow": 200000}}})
