/* ==========================================================================
 * {{tname}}  -  GTK4 / libadwaita theme, skin "{{Name}}".
 * GENERATED by build-gtk.py from templates/gtk-4.0.css.in; edit the template.
 *
 * HOW IT LOADS: libadwaita skips its own stylesheet whenever GTK_THEME is set,
 * so this theme re-imports libadwaita's built-in stylesheet from its gresource
 * (Ubuntu build, Yaru-patched) and overrides it. Later rules win.
 * ========================================================================== */

@import url("resource:///org/gnome/Adwaita/styles/main-{{scheme}}-yaru-default.css");

/* ------------------------------- skin tokens ------------------------------- */
@define-color u_bg      {{bg}};
@define-color u_bg_deep {{deep}};
@define-color u_panel   {{panel}};
@define-color u_panel2  {{hover}};
@define-color u_side    {{side}};
@define-color u_field   {{field}};
@define-color u_sel     {{sel}};
@define-color u_selst   {{selst}};
@define-color u_fg      {{fg}};
@define-color u_dim     {{dim}};
@define-color u_line    {{line}};
@define-color u_line2   {{line2}};
@define-color u_accent  {{accent}};
@define-color u_on_acc  {{on_acc}};
@define-color u_ok      {{ok}};
@define-color u_warn    {{warn}};
@define-color u_bad     {{bad}};

/* libadwaita named colours (GTK4 reads both forms) */
@define-color window_bg_color @u_bg;
@define-color window_fg_color @u_fg;
@define-color view_bg_color @u_bg_deep;
@define-color view_fg_color @u_fg;
@define-color headerbar_bg_color @u_panel;
@define-color headerbar_fg_color @u_fg;
@define-color headerbar_border_color @u_line;
@define-color headerbar_backdrop_color @u_bg;
@define-color headerbar_shade_color transparent;
@define-color headerbar_darker_shade_color transparent;
@define-color sidebar_bg_color @u_side;
@define-color sidebar_fg_color @u_fg;
@define-color sidebar_backdrop_color @u_side;
@define-color sidebar_shade_color {{shade}};
@define-color sidebar_border_color @u_line;
@define-color secondary_sidebar_bg_color @u_side;
@define-color secondary_sidebar_fg_color @u_fg;
@define-color secondary_sidebar_backdrop_color @u_side;
@define-color secondary_sidebar_shade_color {{shade}};
@define-color secondary_sidebar_border_color @u_line;
@define-color card_bg_color {{card}};
@define-color card_fg_color @u_fg;
@define-color card_shade_color {{shade}};
@define-color dialog_bg_color @u_bg;
@define-color dialog_fg_color @u_fg;
@define-color popover_bg_color @u_panel;
@define-color popover_fg_color @u_fg;
@define-color popover_shade_color {{shade}};
@define-color thumbnail_bg_color {{thumb}};
@define-color thumbnail_fg_color @u_fg;
@define-color shade_color {{shade}};
@define-color scrollbar_outline_color transparent;
@define-color accent_bg_color @u_accent;
@define-color accent_fg_color @u_on_acc;
@define-color accent_color @u_accent;
@define-color destructive_bg_color @u_bad;
@define-color destructive_fg_color @u_on_acc;
@define-color destructive_color @u_bad;
@define-color success_bg_color @u_ok;
@define-color success_fg_color @u_on_acc;
@define-color success_color @u_ok;
@define-color warning_bg_color @u_warn;
@define-color warning_fg_color @u_on_acc;
@define-color warning_color @u_warn;
@define-color error_bg_color @u_bad;
@define-color error_fg_color @u_on_acc;
@define-color error_color @u_bad;

:root {
  --window-bg-color: {{bg}};
  --window-fg-color: {{fg}};
  --view-bg-color: {{deep}};
  --view-fg-color: {{fg}};
  --headerbar-bg-color: {{panel}};
  --headerbar-fg-color: {{fg}};
  --headerbar-border-color: {{line}};
  --headerbar-backdrop-color: {{bg}};
  --headerbar-shade-color: transparent;
  --headerbar-darker-shade-color: transparent;
  --sidebar-bg-color: {{side}};
  --sidebar-fg-color: {{fg}};
  --sidebar-backdrop-color: {{side}};
  --sidebar-border-color: {{line}};
  --sidebar-shade-color: {{shade}};
  --secondary-sidebar-bg-color: {{side}};
  --secondary-sidebar-fg-color: {{fg}};
  --secondary-sidebar-backdrop-color: {{side}};
  --secondary-sidebar-border-color: {{line}};
  --secondary-sidebar-shade-color: {{shade}};
  --card-bg-color: {{card}};
  --card-fg-color: {{fg}};
  --card-shade-color: {{shade}};
  --dialog-bg-color: {{bg}};
  --dialog-fg-color: {{fg}};
  --popover-bg-color: {{panel}};
  --popover-fg-color: {{fg}};
  --popover-shade-color: {{shade}};
  --thumbnail-bg-color: {{thumb}};
  --thumbnail-fg-color: {{fg}};
  --shade-color: {{shade}};
  --scrollbar-outline-color: transparent;
  --accent-bg-color: {{accent}};
  --accent-fg-color: {{on_acc}};
  --accent-color: {{accent}};
  --yaru-accent-bg-color: {{accent}};
  --yaru-accent-color: {{accent}};
  --destructive-bg-color: {{bad}};
  --destructive-fg-color: {{on_acc}};
  --destructive-color: {{bad}};
  --success-bg-color: {{ok}};
  --success-fg-color: {{on_acc}};
  --success-color: {{ok}};
  --warning-bg-color: {{warn}};
  --warning-fg-color: {{on_acc}};
  --warning-color: {{warn}};
  --error-bg-color: {{bad}};
  --error-fg-color: {{on_acc}};
  --error-color: {{bad}};
}

/* ------------------------------- typography ------------------------------- */
window, popover, tooltip { font-family: "Chakra Petch", "Segoe UI", system-ui, sans-serif; }

/* ---------------------------------- window -------------------------------- */
/* The compositor draws frame, corner brackets and shadow for CSD windows
 * itself: no shadow and no invisible resize border on the client. */
window.background, window.dialog, window.csd { border-radius: 0; }
window.csd, window.csd:backdrop, window.maximized, window.fullscreen, window.tiled,
window.tiled-left, window.tiled-right, window.tiled-top, window.tiled-bottom,
window.solid-csd { box-shadow: none; margin: 0; outline: none; }
window decoration, window.csd decoration { border-radius: 0; box-shadow: none; margin: 0; }
window.background > contents, window.csd > contents { border-radius: 0; }

/* GTK/libadwaita message dialogs round their window and buttons with high-specificity rules */
window.dialog.message.csd:not(.solid-csd), window.messagedialog.csd:not(.solid-csd),
window.dialog-window.alert.csd:not(.solid-csd), window.csd:not(.solid-csd), window.dialog.csd:not(.solid-csd) {
  border-radius: 0;
}
window.dialog.message.csd .dialog-action-area > button, window.messagedialog .response-area > button,
dialog.alert .response-area > button {
  border-radius: 0; min-height: 20px; min-width: 60px; padding: 4px 16px;
}
window.dialog.message .dialog-action-area, window.messagedialog .response-area { border-spacing: 8px; }

/* -------------------------------- headerbar ------------------------------- */
/* glass-dark bar, 38px, accent bracket top-left, bottom rule fading out;
 * the same look as compositor/src/decoration.c */
headerbar {
  background-color: @u_panel;
  {{hb_bg(accent, line2, line)}}
  color: @u_fg;
  border: none; border-radius: 0; box-shadow: none;
  min-height: 38px; padding: 0; margin: 0;
}
headerbar > windowhandle > box { padding: 0 8px; min-height: 38px; }
headerbar > windowhandle > box > box.start, headerbar > windowhandle > box > box.end { border-spacing: 4px; }
headerbar:backdrop {
  background-color: @u_bg;
  {{hb_bg(accent40, line, line)}}
  color: @u_dim; box-shadow: none;
}
headerbar:backdrop > windowhandle { filter: none; }
headerbar.default-decoration { min-height: 38px; }
headerbar.default-decoration > windowhandle > box { padding: 0 8px; }
headerbar windowhandle, headerbar > windowhandle > box { border-radius: 0; }

/* Title: Michroma, letter-spaced (as in the compositor); subtitle: mono caps */
headerbar .title, windowtitle .title, headerbar windowtitle > box > .title {
  font-family: "Michroma", "Eurostile", "Arial Black", sans-serif;
  font-size: 11.5pt; font-weight: normal; letter-spacing: 0.06em; color: @u_fg;
  padding: 0 12px 0 28px;
  /* accent square before the title, as in the compositor's titlebar */
  background-image: linear-gradient(@u_accent, @u_accent); background-size: 6px 6px;
  background-position: 12px center; background-repeat: no-repeat;
}
headerbar .subtitle, windowtitle .subtitle {
  font-family: "Share Tech Mono", ui-monospace, "DejaVu Sans Mono", monospace;
  font-size: 9pt; font-weight: normal; letter-spacing: 0.18em; text-transform: uppercase;
  color: @u_dim; padding: 0 12px;
}
headerbar:backdrop .title { color: @u_dim; background-image: linear-gradient(@u_dim, @u_dim); }
headerbar separator { background-color: @u_line; min-width: 1px; margin: 8px 3px; }

/* Window controls: Ultimit's  [ _ ]  [ □ ]  [ × ]  as SVG, no circles.
 * (selectors are over-qualified to beat libadwaita's and our generic button rules) */
windowcontrols { margin: 0; border-spacing: 4px; }
windowcontrols > {{WCB}} {
  min-width: 42px; min-height: 28px; padding: 0; margin: 0;
  border-radius: 0; border: none; background-color: transparent;
  box-shadow: none; outline-offset: -2px; color: @u_dim;
}
windowcontrols > {{WCB}}:hover, windowcontrols > {{WCB}}:active, windowcontrols > {{WCB}}:checked {
  background-color: alpha(@u_fg, 0.08); box-shadow: none; border: none;
}
windowcontrols > {{WCB}}.close:hover, windowcontrols > {{WCB}}.close:active { background-color: alpha(@u_bad, 0.20); }
windowcontrols > button > image { min-width: 0; min-height: 0; padding: 0; margin: 0; background: none;
  border-radius: 0; box-shadow: none; border: none; opacity: 0; }
{{titlebuttons(["windowcontrols >"], WCB)}}
windowcontrols > .icon { margin: 0 8px; }

/* --------------------------------- buttons -------------------------------- */
button, button.pill, button.circular, button.opaque, button.card,
splitbutton > button, splitbutton > menubutton > button,
menubutton > button, dropdown > button, combobox button, spinbutton > button,
.linked > button, .linked > menubutton > button { border-radius: 0; }
button, menubutton > button, dropdown > button, splitbutton > button, splitbutton > menubutton > button {
  background-color: transparent;
  {{chamfer(line2, bg)}}
  border: none; box-shadow: none; color: @u_fg;
  min-height: 20px; padding: 3px 14px; font-weight: 600; letter-spacing: 0.06em;
  outline-color: @u_accent;
}
button:hover, menubutton > button:hover, dropdown > button:hover { background-color: @u_panel2; {{chamfer(accent, bg)}} }
button:active, button:checked, menubutton > button:checked, dropdown > button:checked {
  background-color: @u_sel; {{chamfer(accent, bg)}} color: @u_fg;
}
button:disabled { color: @u_dim; {{chamfer(line, bg)}} background-color: transparent; opacity: .7; }
button:focus-visible { outline: 1px dotted @u_accent; outline-offset: -4px; }
button:backdrop { color: @u_dim; }

button.flat, button.image-button.flat, headerbar button.flat, toolbarview button.flat, button.circular {
  background-color: transparent; background-image: none; border: 1px solid transparent; padding: 2px 8px;
}
button.flat:hover, button.circular:hover { background-color: @u_panel2; border-color: @u_line; background-image: none; }
button.flat:checked, button.flat:active { background-color: @u_sel; border-color: @u_accent; background-image: none; }

button.suggested-action, button.suggested-action.pill {
  background-color: @u_accent; {{chamfer(accent, bg)}} color: @u_on_acc;
}
button.suggested-action:hover { background-color: {{accent_hover}}; {{chamfer(accent_hover, bg)}} }
button.suggested-action:disabled { background-color: @u_panel2; {{chamfer(line, bg)}} color: @u_dim; }
button.destructive-action { background-color: transparent; {{chamfer(bad, bg)}} color: @u_bad; }
button.destructive-action:hover { background-color: @u_bad; {{chamfer(bad, bg)}} color: @u_on_acc; }
button.opaque { background-color: @u_panel2; {{chamfer(line2, bg)}} }

/* buttons on panel-coloured surfaces cut their corners in that colour */
headerbar button:not(.flat), popover button:not(.flat):not(.model), toolbarview > .top-bar button:not(.flat),
actionbar button:not(.flat), searchbar button:not(.flat) {
  {{chamfer(line2, panel)}} min-height: 18px; padding: 2px 12px; margin: 4px 0;
}
headerbar button:not(.flat):hover, popover button:not(.flat):hover { {{chamfer(accent, panel)}} background-color: @u_panel2; }
headerbar button:not(.flat):checked, headerbar button:not(.flat):active { {{chamfer(accent, panel)}} background-color: @u_sel; }
headerbar button.suggested-action { background-color: @u_accent; {{chamfer(accent, panel)}} color: @u_on_acc; }
headerbar button.destructive-action { {{chamfer(bad, panel)}} }
headerbar button.image-button, headerbar button.flat, headerbar menubutton > button { padding: 2px 6px; margin: 4px 0; }
headerbar entry, headerbar spinbutton, headerbar searchentry { margin: 4px 0; }
.linked > button:not(:first-child) { margin-left: -1px; }

/* ------------------------------ entries / text ----------------------------- */
entry, spinbutton, searchbar > revealer > box, .searchbar entry, passwordentry, text, textview, entry.search, searchentry {
  border-radius: 0;
}
entry, spinbutton, passwordentry, searchentry {
  background-color: @u_field; background-image: none; border: 1px solid @u_line; border-bottom-color: @u_line2;
  box-shadow: none; color: @u_fg; min-height: 24px; caret-color: @u_accent; padding: 0 8px;
}
entry:focus-within, spinbutton:focus-within, passwordentry:focus-within, searchentry:focus-within {
  border-color: @u_accent; outline: none; {{layers(bracket(accent, 8, 2))}}
}
entry:disabled, spinbutton:disabled { color: @u_dim; background-color: @u_bg; border-color: {{line}}; }
entry.error, entry.error:focus-within { border-color: @u_bad; }
entry selection, text selection, textview text selection, label selection { background-color: @u_selst; color: @u_fg; }
textview, textview text { background-color: @u_bg_deep; color: @u_fg; }
spinbutton > button { border: none; border-left: 1px solid @u_line; background-image: none; min-height: 0; padding: 0 6px; }
dropdown popover listview > row { border-radius: 0; }

/* --------------------------- lists / sidebars / views ---------------------- */
list, listview, columnview, gridview, .boxed-list, .card, row, row.card, .navigation-sidebar > row {
  border-radius: 0;
}
list, listview { background-color: transparent; color: @u_fg; }
row, listview > row, columnview > listview > row, .navigation-sidebar > row, list.navigation-sidebar > row {
  background-color: transparent;
  background-image: none;
  box-shadow: none;
  border-radius: 0;
  margin: 0;
}
row:hover, listview > row:hover, columnview > listview > row:hover,
.navigation-sidebar > row:hover, gridview > child:hover, .navigation-sidebar > row:hover:not(:selected) {
  background-color: @u_panel2;
}
row:selected, listview > row:selected, columnview > listview > row:selected,
.navigation-sidebar > row:selected, .navigation-sidebar > row:selected:hover,
list.navigation-sidebar > row:selected, row.activatable:selected, row.activatable:selected:hover {
  background-color: @u_sel;
  color: @u_fg;
  box-shadow: inset 2px 0 0 @u_accent;       /* mockup's .row.sel bar */
}
row:selected image, row:selected label { color: @u_fg; }
gridview > child, gridview > child > box { border-radius: 0; }
gridview > child:selected, flowbox > flowboxchild:selected, iconview:selected {
  background-color: @u_sel;
  box-shadow: inset 0 0 0 1px @u_accent;
}
.boxed-list, list.boxed-list, .card {
  border: 1px solid @u_line;
  background-color: @u_panel2;
  box-shadow: none;
}
.boxed-list > row { border-bottom: 1px solid @u_line; }
.boxed-list > row:last-child { border-bottom: none; }
row.expander row.header { border-radius: 0; }
columnview > header > button, columnview > listview > header { border-radius: 0; background: none; }
.view, textview, iconview, columnview, treeview.view { background-color: @u_bg_deep; color: @u_fg; }
treeview.view:selected, .view:selected { background-color: @u_sel; color: @u_fg; }
treeview.view:hover { background-color: @u_panel2; }

/* Section labels like the mockup's .lbl */
.heading, .caption-heading {
  font-family: "Share Tech Mono", ui-monospace, monospace;
  font-size: 10px;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: @u_dim;
  font-weight: normal;
}
.dim-label, .dim, label.dim { color: @u_dim; }

/* sidebars / panes */
.sidebar-pane, .navigation-sidebar, .sidebar, splitview > sidebar, navigation-split-view > .sidebar-pane {
  background-color: @u_side;
  border-radius: 0;
}
separator, .sidebar-pane separator { background-color: @u_line; min-width: 1px; min-height: 1px; }
toolbarview > .top-bar, toolbarview > .bottom-bar, actionbar > revealer > box, searchbar > revealer > box {
  background-color: @u_panel;
  box-shadow: inset 0 -1px @u_line;
  border-radius: 0;
}
toolbarview > .bottom-bar, actionbar > revealer > box { box-shadow: inset 0 1px @u_line; }

/* ---------------------------- popovers & menus ---------------------------- */
popover, popover.background { background: none; box-shadow: none; }
popover > contents, popover.background > contents, popover.menu > contents {
  background-color: @u_panel;
  background-image: none;
  color: @u_fg;
  border: 1px solid @u_line2;
  border-radius: 0;
  box-shadow: 0 8px 24px rgba(0,0,0,.5);
}
popover > arrow { background-color: @u_panel; border: 1px solid @u_line2; border-radius: 0; }
popover modelbutton, popover.menu modelbutton {
  border-radius: 0;
  min-height: 28px;
}
popover modelbutton:hover, popover.menu modelbutton:hover, popover.menu modelbutton:focus {
  background-color: @u_panel2;
  box-shadow: inset 2px 0 0 @u_accent;
}
popover button.flat, popover .menu button { border-radius: 0; }
tooltip, tooltip.background {
  background-color: @u_panel;
  border: 1px solid @u_line2;
  border-radius: 0;
  color: @u_fg;
  box-shadow: none;
}
.osd, toast, .toolbar.osd { border-radius: 0; background-color: @u_panel; color: @u_fg; border: 1px solid @u_line2; }
toast { border-left: 3px solid @u_accent; }

/* ------------------------------- dialogs ---------------------------------- */
dialog-host > dialog.floating sheet, dialog.floating > sheet, dialog > sheet, sheet {
  border-radius: 0;
  border: 1px solid @u_line2;
  background-color: @u_bg;
}
window.dialog.message, window.messagedialog, window.messagedialog.csd, messagedialog { border-radius: 0; }
dialog.bottom-sheet > sheet { border-radius: 0; }
infobar, banner, banner > revealer > widget { border-radius: 0; }

/* ------------------- switches / checks / radios / scales ------------------ */
switch {
  border-radius: 0;
  background-color: @u_panel2;
  background-image: none;
  border: 1px solid @u_line2;
  box-shadow: none;
  min-width: 36px;
  min-height: 18px;
  outline-color: @u_accent;
}
switch:checked { background-color: @u_sel; border-color: @u_accent; }
switch slider {
  border-radius: 0;
  background-color: @u_dim;
  background-image: none;
  border: none;
  box-shadow: none;
  min-width: 12px;
  min-height: 12px;
  margin: 2px;
}
switch:checked slider { background-color: @u_accent; }
switch:disabled { opacity: .5; }

check, radio, checkbutton check, checkbutton radio, .view check, .view radio {
  border-radius: 0;
  background-color: transparent;
  background-image: none;
  border: 1px solid @u_line2;
  box-shadow: none;
  color: @u_on_acc;
  min-width: 16px;
  min-height: 16px;
  -gtk-icon-shadow: none;
}
check:checked, check:indeterminate, radio:checked, radio:indeterminate {
  background-color: @u_accent;
  border-color: @u_accent;
  color: @u_on_acc;
}
check:hover, radio:hover { border-color: @u_accent; }
checkbutton:focus-visible check, checkbutton:focus-visible radio { outline: 1px solid @u_accent; outline-offset: 2px; }

scale trough, progressbar trough, levelbar trough, scale fill, progressbar progress, levelbar block {
  border-radius: 0;
}
scale trough, scale > trough, progressbar trough, levelbar trough {
  background-color: @u_panel2;
  border: 1px solid @u_line;
  box-shadow: none;
  min-height: 6px;
}
scale highlight, scale fill, progressbar progress, levelbar block.filled {
  background-color: @u_accent;
  background-image: none;
  border-radius: 0;
}
levelbar block.empty { background-color: transparent; }
levelbar block.low { background-color: @u_warn; }
levelbar block.full { background-color: @u_ok; }
scale slider, scale > trough > slider, scale.horizontal > trough > slider, scale.vertical > trough > slider {
  border-radius: 0;
  background-color: @u_accent;
  background-image: none;
  border: none;
  box-shadow: none;
}
scale slider:hover, scale > trough > slider:hover { background-color: @u_fg; }
progressbar > text { color: @u_fg; font-family: "Share Tech Mono", monospace; }

/* ------------------------------- scrollbars ------------------------------- */
scrollbar, scrollbar trough { background: none; border-radius: 0; border: none; }
scrollbar slider {
  border-radius: 0;
  background-color: @u_line2;
  min-width: 4px;
  min-height: 4px;
  border: none;
}
scrollbar.overlay-indicator:not(.hovering) slider { min-width: 2px; min-height: 2px; }
scrollbar slider:hover, scrollbar slider:active { background-color: @u_accent; }
scrollbar.overlay-indicator:not(.hovering) { background: none; }
undershoot, overshoot { background: none; }

/* ---------------------------- tabs / notebooks ---------------------------- */
tabbar, tabbar > revealer > box, notebook > header { background-color: @u_panel; border-radius: 0; box-shadow: inset 0 -1px @u_line; }
tabbar tab, notebook > header > tabs > tab {
  border-radius: 0; background: none; color: @u_dim; border: none; box-shadow: none;
}
tabbar tab:hover, notebook > header > tabs > tab:hover { background-color: @u_panel2; color: @u_fg; }
tabbar tab:selected, notebook > header > tabs > tab:checked {
  background-color: @u_sel; color: @u_fg; box-shadow: inset 0 -2px @u_accent;
}
viewswitcher button, viewswitcher button.toggle { border-radius: 0; }
viewswitcher button:checked { box-shadow: inset 0 -2px @u_accent; background-color: @u_sel; }
toggle-group, toggle-group > toggle, .toggle-group { border-radius: 0; }

/* -------------------- status colours / misc ------------------------------- */
.success, label.success { color: @u_ok; }
.warning, label.warning { color: @u_warn; }
.error, label.error { color: @u_bad; }
.accent { color: @u_accent; }
link, link:hover, .link, button.link, label link { color: @u_accent; }
avatar { border-radius: 9999px; } /* keep avatars round; everything else is square */
calendar, calendar > header, calendar > grid > label.day-number { border-radius: 0; }
calendar > grid > label.day-number:selected { background-color: @u_accent; color: @u_on_acc; }
progressbar.osd > trough { border: none; }
*:focus-visible { outline-color: @u_accent; }
