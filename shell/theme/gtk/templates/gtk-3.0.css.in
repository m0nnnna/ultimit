/* ==========================================================================
 * {{tname}}  -  GTK3 theme, skin "{{Name}}".   GENERATED by build-gtk.py from
 * templates/gtk-3.0.css.in. Do not edit the output; edit the template.
 *
 * Also what Electron (Claude desktop etc.) and Chromium in GTK mode read:
 * Chromium samples the headerbar.titlebar / window / button / entry / menu /
 * selection style contexts, so those use OPAQUE colours and no gradients on
 * the base fill.
 * Built on GTK3's builtin Adwaita{{dark_suffix}} (contained) and overridden.
 * ========================================================================== */
@import url("resource:///org/gtk/libgtk/theme/Adwaita/gtk-contained{{dark_suffix}}.css");

/* ------------------------------- skin tokens ------------------------------- */
@define-color u_bg      {{bg}};      /* window                         */
@define-color u_deep    {{deep}};    /* views, text                    */
@define-color u_panel   {{panel}};   /* headerbar, menus, popovers     */
@define-color u_side    {{side}};    /* sidebars                       */
@define-color u_field   {{field}};   /* entries                        */
@define-color u_hover   {{hover}};   /* hover fill                     */
@define-color u_sel     {{sel}};     /* selected row (accent @ ~20%)   */
@define-color u_selst   {{selst}};   /* selected text                  */
@define-color u_fg      {{fg}};
@define-color u_dim     {{dim}};
@define-color u_line    {{line}};
@define-color u_line2   {{line2}};
@define-color u_accent  {{accent}};
@define-color u_on_acc  {{on_acc}};
@define-color u_ok      {{ok}};
@define-color u_warn    {{warn}};
@define-color u_bad     {{bad}};

/* GTK3 Adwaita named colours */
@define-color theme_bg_color {{bg}};
@define-color theme_fg_color {{fg}};
@define-color theme_base_color {{deep}};
@define-color theme_text_color {{fg}};
@define-color theme_selected_bg_color {{accent}};
@define-color theme_selected_fg_color {{on_acc}};
@define-color theme_unfocused_bg_color {{bg}};
@define-color theme_unfocused_fg_color {{dim}};
@define-color theme_unfocused_base_color {{deep}};
@define-color theme_unfocused_text_color {{fg}};
@define-color theme_unfocused_selected_bg_color {{accent}};
@define-color theme_unfocused_selected_fg_color {{on_acc}};
@define-color insensitive_bg_color {{panel}};
@define-color insensitive_fg_color {{dim}};
@define-color insensitive_base_color {{deep}};
@define-color borders {{line_solid}};
@define-color unfocused_borders {{line_solid}};
@define-color warning_color {{warn}};
@define-color error_color {{bad}};
@define-color success_color {{ok}};
@define-color content_view_bg {{deep}};
@define-color link_color {{accent}};
@define-color link_visited_color {{accent}};
@define-color tooltip_bg_color {{panel}};
@define-color tooltip_fg_color {{fg}};
@define-color tooltip_border_color {{line2_solid}};
@define-color menu_bg_color {{panel}};
@define-color menu_fg_color {{fg}};
/* names Chromium / Electron look up */
@define-color wm_bg_a {{panel}};
@define-color wm_bg_b {{panel}};
@define-color wm_title {{fg}};
@define-color wm_unfocused_title {{dim}};
@define-color headerbar_bg_color {{panel}};
@define-color headerbar_fg_color {{fg}};
@define-color titlebar_bg_color {{panel}};
@define-color titlebar_fg_color {{fg}};

* { -GtkScrolledWindow-scrollbar-spacing: 0; outline-color: @u_accent; -gtk-outline-radius: 0; }

/* -------------------------------- window ---------------------------------- */
/* The compositor draws frame, corner brackets and shadow for CSD windows
 * itself, so the client keeps no shadow and no invisible resize border. */
decoration, window decoration, window.csd decoration, window.background.csd, window.csd, .csd {
  border-radius: 0;
}
window, window.background, dialog, .background { background-color: @u_bg; color: @u_fg; }
label { color: inherit; }
label:disabled, *:disabled label { color: @u_dim; }
decoration, window.csd decoration, window.popup decoration, .popup decoration {
  box-shadow: none; border: none; margin: 0; border-radius: 0;
}
window, dialog, tooltip, menu, popover { font-family: "{{font_ui}}", "Segoe UI", system-ui, sans-serif; }

/* ------------------------- headerbar / titlebar --------------------------- */
/* glass-dark bar, 38px, accent bracket top-left, rule along the bottom that
 * fades out, like compositor/src/decoration.c */
headerbar, .titlebar, headerbar.titlebar, window.csd > .titlebar {
  background-color: @u_panel;
  {{hb_bg(accent, line2, line)}}
  color: @u_fg;
  border: none; border-radius: 0; box-shadow: none; text-shadow: none;
  min-height: 38px; padding: 0 8px;
}
headerbar:backdrop, .titlebar:backdrop, headerbar.titlebar:backdrop {
  background-color: @u_bg;
  {{hb_bg(accent40, line, line)}}
  color: @u_dim;
}
headerbar .title, .titlebar .title, headerbar.titlebar .title {
  font-family: "{{font_display}}", "Eurostile", "Arial Black", sans-serif;
  font-size: 11.5pt; font-weight: normal; letter-spacing: 0.06em; color: @u_fg;
  /* accent square before the title, as in the compositor's titlebar */
  padding-left: 16px;
  background-image: linear-gradient(@u_accent, @u_accent); background-size: 6px 6px;
  background-position: left center; background-repeat: no-repeat;
}
headerbar:backdrop .title, .titlebar:backdrop .title { color: @u_dim; background-image: linear-gradient(@u_dim, @u_dim); }
headerbar .subtitle, .titlebar .subtitle {
  font-family: "{{font_mono}}", monospace; font-size: 9pt; font-weight: normal;
  letter-spacing: 0.18em; color: @u_dim; min-height: 0; margin-top: -3px; opacity: 1; font-size: 7.5pt;
}
headerbar entry, headerbar spinbutton, .titlebar entry { margin: 4px 0; }
headerbar separator, .titlebar separator { background-color: @u_line; min-width: 1px; margin: 8px 3px; }

/* Window controls: the compositor titlebar's small drawn icons as SVG, no circles;
 * the hover box and its corner brackets are part of the SVG */
headerbar button.titlebutton, .titlebar button.titlebutton, headerbar.titlebar button.titlebutton {
  min-width: 30px; min-height: 22px; padding: 0; margin: 0;
  border-radius: 0; border: none; background-color: transparent;
  box-shadow: none; text-shadow: none; -gtk-icon-shadow: none; outline-offset: -2px;
  color: @u_dim;
}
headerbar button.titlebutton:hover, headerbar button.titlebutton:active, headerbar button.titlebutton:checked,
.titlebar button.titlebutton:hover, .titlebar button.titlebutton:active {
  background-color: transparent; border: none; box-shadow: none;
}
headerbar button.titlebutton.close:hover, .titlebar button.titlebutton.close:hover,
headerbar button.titlebutton.close:active, .titlebar button.titlebutton.close:active { background-color: transparent; }
headerbar button.titlebutton image, .titlebar button.titlebutton image {
  min-width: 0; min-height: 0; padding: 0; margin: 0; background: none; box-shadow: none; opacity: 0;
  color: transparent; -gtk-icon-shadow: none; border: none; border-radius: 0;
}
{{titlebuttons(["headerbar", ".titlebar"], "button.titlebutton")}}

/* -------------------------------- buttons --------------------------------- */
/* chamfered outline: cut top-left/bottom-right corners, drawn with gradients */
button, .linked > button, .linked:not(.vertical) > button, .linked.vertical > button,
combobox button, spinbutton button, button.text-button, button.image-button {
  border-radius: 0; border: none; box-shadow: none; text-shadow: none; -gtk-icon-shadow: none;
  background-color: transparent;
  {{chamfer(line2, bg)}}
  color: @u_fg; min-height: 20px; padding: 3px 14px; margin: 0;
  font-weight: 600; letter-spacing: 0.06em;
}
button:hover, button:focus:hover { background-color: @u_hover; {{chamfer(accent, bg)}} }
button:active, button:checked, button:active:hover, button:checked:hover {
  background-color: @u_sel; {{chamfer(accent, bg)}} color: @u_fg;
}
button:disabled, button:disabled:hover { color: @u_dim; background-color: transparent; {{chamfer(line, bg)}} }
button:backdrop { color: @u_dim; }
button:focus { outline: 1px dotted @u_accent; outline-offset: -4px; }
button.flat, button.flat:backdrop, toolbar button, .toolbar button, button.titlebutton.flat {
  background-color: transparent; background-image: none; border: 1px solid transparent; padding: 2px 10px;
}
button.flat:hover, toolbar button:hover { background-color: @u_hover; border-color: {{line}}; }
button.flat:active, button.flat:checked, toolbar button:checked { background-color: @u_sel; border-color: @u_accent; }
button.suggested-action, button.suggested-action:backdrop {
  background-color: @u_accent; {{chamfer(accent, bg)}} color: @u_on_acc;
}
button.suggested-action:hover { background-color: {{accent_hover}}; {{chamfer(accent_hover, bg)}} }
button.suggested-action:disabled { background-color: @u_hover; {{chamfer(line, bg)}} color: @u_dim; }
button.destructive-action { background-color: transparent; {{chamfer(bad, bg)}} color: @u_bad; }
button.destructive-action:hover { background-color: @u_bad; {{chamfer(bad, bg)}} color: @u_on_acc; }
.linked > button:not(:first-child) { margin-left: -1px; }
/* buttons sitting on panel-coloured surfaces cut their corners in that colour */
headerbar button:not(.titlebutton), .titlebar button:not(.titlebutton), popover button, menu button, .toolbar button,
actionbar button, searchbar button, notebook > header button {
  {{chamfer(line2, panel)}} min-height: 18px; padding: 2px 12px; margin: 4px 0;
}
headerbar button:not(.titlebutton):hover, .titlebar button:not(.titlebutton):hover, popover button:hover, actionbar button:hover {
  {{chamfer(accent, panel)}} background-color: @u_hover;
}
headerbar button:not(.titlebutton):checked, headerbar button:not(.titlebutton):active, popover button:checked {
  {{chamfer(accent, panel)}} background-color: @u_sel;
}
headerbar button.suggested-action, popover button.suggested-action { background-color: @u_accent; {{chamfer(accent, panel)}} color: @u_on_acc; }
headerbar button.destructive-action { {{chamfer(bad, panel)}} }
headerbar button.flat, popover button.flat, popover modelbutton.flat { background-image: none; border: 1px solid transparent; }
headerbar button.image-button, headerbar button.flat { padding: 2px 6px; }

/* --------------------------------- entries -------------------------------- */
entry, spinbutton, textview { border-radius: 0; }
entry, spinbutton {
  background-color: @u_field; background-image: none; border: 1px solid @u_line; border-bottom-color: @u_line2;
  box-shadow: none; color: @u_fg; min-height: 24px; padding: 0 8px; caret-color: @u_accent;
  text-shadow: none;
}
entry:focus, spinbutton:focus {
  border-color: @u_accent; background-color: @u_field;
  {{layers(bracket(accent, 8, 2))}}
  box-shadow: none;
}
entry:backdrop, spinbutton:backdrop:not(.vertical), spinbutton:not(.vertical):backdrop {
  background-color: @u_field; color: @u_fg; border-color: @u_line; box-shadow: none;
}
entry:disabled, spinbutton:disabled { color: @u_dim; background-color: @u_bg; border-color: {{line}}; }
entry.error { border-color: @u_bad; }
entry image, entry image.right { color: @u_dim; }
entry selection, selection, *:selected, textview text selection, label selection {
  background-color: @u_selst; color: @u_fg;
}
entry:focus selection, textview:focus text selection { background-color: @u_selst; }
textview, textview text, .view, iconview, treeview.view { background-color: @u_deep; color: @u_fg; }
spinbutton button, spinbutton:not(.vertical) button, spinbutton.vertical button {
  border: none; border-left: 1px solid @u_line; background-image: none; background-color: transparent; box-shadow: none;
  min-height: 0; padding: 0 6px; margin: 0;
}
spinbutton button:hover { background-color: @u_hover; }
spinbutton:not(.vertical), spinbutton:not(.vertical):focus { background-image: none; }
placeholder, entry placeholder { color: @u_dim; }

/* ----------------------------- lists / views ------------------------------ */
row, list row, .sidebar row, treeview.view, iconview { border-radius: 0; }
list, list row { background-color: transparent; color: @u_fg; }
row:hover, list row:hover { background-color: @u_hover; }
row:selected, list row:selected, row:selected:hover, list row:selected:hover,
.sidebar row:selected, .sidebar row:selected:hover, placessidebar row:selected {
  background-color: @u_sel; color: @u_fg; box-shadow: inset 2px 0 0 @u_accent;
}
treeview.view { border-color: @u_line; }
treeview.view:hover { background-color: @u_hover; }
treeview.view:selected, treeview.view:selected:focus, iconview:selected, .view:selected, .view:selected:focus {
  background-color: @u_sel; color: @u_fg; box-shadow: none;
}
treeview.view:selected:backdrop { background-color: @u_sel; }
iconview:selected { box-shadow: inset 0 0 0 1px @u_accent; }
treeview.view.separator { color: @u_line; min-height: 2px; }
treeview.view acceleditor > label { background-color: @u_sel; }
treeview.view header button, treeview header button {
  background-color: @u_panel; background-image: none; border: none; border-radius: 0;
  border-bottom: 1px solid @u_line2; border-right: 1px solid @u_line; box-shadow: none;
  color: @u_dim; font-family: "{{font_mono}}", monospace; font-size: 9pt; font-weight: normal;
  letter-spacing: 0.16em; padding: 3px 8px; min-height: 20px;
}
treeview.view header button:hover { color: @u_fg; background-color: @u_hover; background-image: none; }
.sidebar, placessidebar, stacksidebar { background-color: @u_side; border-color: @u_line; }
placessidebar row { min-height: 28px; }
separator { background-color: @u_line; min-width: 1px; min-height: 1px; }
frame > border, .frame { border-color: @u_line; border-radius: 0; box-shadow: none; }
scrolledwindow, scrolledwindow viewport { border-color: @u_line; }
toolbar, toolbar.horizontal, toolbar.vertical, .toolbar, .inline-toolbar, actionbar, searchbar, .primary-toolbar { background-color: @u_panel; background-image: none; border-color: @u_line; border-radius: 0; box-shadow: none; }
statusbar { color: @u_dim; }

/* ---------------------------- popovers / menus ---------------------------- */
popover, popover.background, .popover {
  background-color: @u_panel; background-image: none; border: 1px solid @u_line2; border-radius: 0;
  box-shadow: 0 8px 24px {{shadow}}; color: @u_fg;
}
popover arrow { background-color: @u_panel; border: 1px solid @u_line2; }
menu, .menu, .context-menu, menubar, .menubar {
  background-color: @u_panel; background-image: none; color: @u_fg; border-radius: 0; box-shadow: none;
}
menu, .menu, .context-menu, .popup menu, window.popup > menu { border: 1px solid @u_line2; padding: 3px 0; margin: 0; box-shadow: none; background-color: @u_panel; }
menu menuitem, menubar menuitem, .menu menuitem { background-color: transparent; color: @u_fg; border-radius: 0; padding: 4px 10px; min-height: 18px; }
menuitem:hover, menu menuitem:hover, menubar > menuitem:hover, modelbutton:hover, menuitem:focus {
  background-color: @u_hover; color: @u_fg; box-shadow: inset 2px 0 0 @u_accent;
}
menuitem:disabled, menuitem label:disabled { color: @u_dim; }
menuitem arrow, menuitem check, menuitem radio { color: @u_dim; }
menu separator, menuitem separator { background-color: @u_line; margin: 3px 0; min-height: 1px; }
modelbutton { border-radius: 0; border: none; background: none; box-shadow: none; }
tooltip, tooltip.background {
  background-color: @u_panel; background-image: none; border: 1px solid @u_line2; border-radius: 0;
  color: @u_fg; box-shadow: none; text-shadow: none;
}
tooltip decoration { box-shadow: none; }
tooltip * { color: @u_fg; }
.osd { border-radius: 0; background-color: @u_panel; border: 1px solid @u_line2; color: @u_fg; }

/* -------------------- switch / check / radio / scale / bars --------------- */
switch {
  border-radius: 0; background-color: @u_field; background-clip: border-box; background-image: none;
  border: 1px solid @u_line2; box-shadow: none; color: @u_dim; text-shadow: none; min-width: 40px; min-height: 18px;
}
switch:checked { background-color: @u_sel; border-color: @u_accent; color: @u_fg; }
switch:disabled { border-color: @u_line; }
switch slider {
  min-width: 18px; min-height: 18px; margin: -1px; border-radius: 0; background-color: @u_dim; background-image: none;
  border: none; box-shadow: none;
}
switch:checked slider { background-color: @u_accent; }
check, radio {
  border-radius: 0; background-color: @u_field; background-image: none; border: 1px solid @u_line2;
  box-shadow: none; color: @u_on_acc; -gtk-icon-shadow: none; min-width: 14px; min-height: 14px;
}
radio { border-radius: 0; }
check:hover, radio:hover { border-color: @u_accent; background-image: none; }
check:checked, check:indeterminate, radio:checked, radio:indeterminate {
  background-color: @u_accent; border-color: @u_accent; color: @u_on_acc; background-image: none;
}
check:disabled, radio:disabled { border-color: @u_line; background-color: transparent; }
scale trough, progressbar trough, levelbar trough {
  border-radius: 0; background-color: @u_field; background-image: none; border: 1px solid @u_line; box-shadow: none;
}
scale trough { min-height: 4px; min-width: 4px; }
scale highlight, progressbar progress, levelbar block.filled {
  border-radius: 0; background-color: @u_accent; background-image: none; border: none; box-shadow: none;
}
scale slider {
  border-radius: 0; background-color: @u_accent; background-image: none; border: none; box-shadow: none;
  min-width: 10px; min-height: 10px; margin: -6px;
}
scale slider:hover, scale slider:active { background-color: @u_fg; }
scale marks, scale value { color: @u_dim; }
progressbar { color: @u_fg; font-family: "{{font_mono}}", monospace; font-size: 9pt; }
progressbar trough { min-height: 6px; }
levelbar block.empty { background-color: transparent; border-color: @u_line; }
levelbar block.low { background-color: @u_warn; }
levelbar block.high, levelbar block.full { background-color: @u_ok; }

/* -------------------------------- scrollbars ------------------------------ */
scrollbar, scrollbar trough { background: none; border: none; border-radius: 0; }
scrollbar slider { border-radius: 0; background-color: @u_line2; min-width: 4px; min-height: 4px; border: 2px solid transparent; background-clip: padding-box; }
scrollbar.overlay-indicator:not(.hovering) slider { min-width: 2px; min-height: 2px; }
scrollbar.vertical slider { min-height: 24px; }
scrollbar.horizontal slider { min-width: 24px; }
scrollbar slider:hover, scrollbar slider:active { background-color: @u_accent; }
scrollbar button { min-width: 0; min-height: 0; padding: 0; background: none; border: none; }
undershoot, overshoot { background: none; }

/* ---------------------------- notebook / tabs ----------------------------- */
notebook { background-color: @u_bg; }
notebook > header { background-color: @u_panel; border-color: @u_line; border-radius: 0; box-shadow: none; }
notebook > header > tabs > tab {
  border-radius: 0; background: none; color: @u_dim; border: 1px solid transparent; box-shadow: none;
  padding: 4px 14px; min-height: 20px; font-weight: 600; letter-spacing: 0.06em;
}
notebook > header > tabs > tab:hover { background-color: @u_hover; color: @u_fg; }
notebook > header.top > tabs > tab:checked { color: @u_fg; background-color: @u_sel; box-shadow: inset 0 -2px @u_accent; }
notebook > header.bottom > tabs > tab:checked { color: @u_fg; background-color: @u_sel; box-shadow: inset 0 2px @u_accent; }
notebook > header.left > tabs > tab:checked { color: @u_fg; background-color: @u_sel; box-shadow: inset -2px 0 @u_accent; }
notebook > header.right > tabs > tab:checked { color: @u_fg; background-color: @u_sel; box-shadow: inset 2px 0 @u_accent; }
notebook > stack:not(:only-child) { background-color: @u_bg; }
notebook > header > tabs > tab button { padding: 0; min-height: 0; min-width: 0; background: none; border: none; }
stackswitcher button.text-button { padding: 2px 14px; }

/* ---------------------------- infobar / dialogs --------------------------- */
infobar, infobar.info, infobar.warning, infobar.error, infobar.question {
  border-radius: 0; background-color: @u_panel; border-bottom: 1px solid @u_line2; color: @u_fg;
}
infobar.warning { box-shadow: inset 3px 0 @u_warn; } infobar.error { box-shadow: inset 3px 0 @u_bad; }
infobar.info, infobar.question { box-shadow: inset 3px 0 @u_accent; }
dialog .dialog-action-area, messagedialog .dialog-action-area { border-top: 1px solid @u_line; }
messagedialog.background { background-color: @u_bg; }
messagedialog .titlebar { min-height: 38px; }
.dim-label, label.dim { color: @u_dim; }
frame > label, .heading { font-family: "{{font_mono}}", monospace; letter-spacing: 0.18em; font-size: 9pt; color: @u_dim; }

/* ----------------------------- colours / links ---------------------------- */
.success, label.success { color: @u_ok; } .warning, label.warning { color: @u_warn; } .error, label.error { color: @u_bad; }
button:link > label, button:visited > label, button:link, button:visited, button:hover:link, *:link:visited, link, *:link, *:visited, label link, label link:hover, button:link, button:visited, button.link, button.link:hover, *:link:hover { color: @u_accent; }
calendar { color: @u_fg; border-color: @u_line; }
calendar:selected { background-color: @u_accent; color: @u_on_acc; border-radius: 0; }
