#!/bin/sh
# ultimit-data [path] - open DATA (the Ultimit file manager) at path (default: home).
# ultimit-data --reveal <file> - open the file's folder with the file selected ("Show in folder").
reveal=""
[ "$1" = "--reveal" ] && reveal=1 && shift
p="${1:-$HOME}"
case "$p" in file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${p#file://}");; esac
[ -e "$p" ] && p="$(realpath -- "$p")"
SHELL_DIR="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
# Started by D-Bus or the portal (a browser's "Show in folder"), PATH is systemd's,
# without Ultimit's bin dir: look for qs where the installer and build-deps.sh put it.
QS=$(command -v qs) || for q in "$SHELL_DIR/../bin/qs" "${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}/bin/qs"; do
	[ -x "$q" ] && QS=$q && break
done
if [ -n "$reveal" ]; then
	exec "${QS:-qs}" -p "$SHELL_DIR" ipc call data reveal "$p"
fi
exec "${QS:-qs}" -p "$SHELL_DIR" ipc call data open "$p"
