#!/bin/sh
# ultimit-image [FILE...|DIR] - open pictures in IMAGE, the Ultimit image viewer. One file: that picture, with
# the others in its folder to step through. Several files: just those, in one window. A folder, or nothing:
# the library (that folder, or Pictures, as thumbnails).
# IMAGE is its own quickshell process (image-shell.qml), started here when not yet running; it exits
# when its last window closes.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/image-shell.qml"
# Started by xdg-open from a D-Bus activated app, PATH can lack Ultimit's bin dir: find qs like ultimit-data.
QS=$(command -v qs) || for q in "$shell/../bin/qs" "${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}/bin/qs"; do
	[ -x "$q" ] && QS=$q && break
done
QS=${QS:-qs}

image() { "$QS" -p "$cfg" ipc call image "$@" >/dev/null 2>&1; }

if ! image state; then
	"$QS" -p "$cfg" -n -d >/dev/null 2>&1
	i=0
	until image state; do
		i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-image: IMAGE did not start" >&2; exit 1; }
		sleep 0.2
	done
fi

paths=""
for p in "$@"; do
	case "$p" in file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${p#file://}");; esac
	case "$p" in /*) ;; *) p="$PWD/$p";; esac
	paths="$paths$p
"
done
if [ $# -eq 0 ]; then
	image gallery ""
elif [ $# -eq 1 ] && [ -d "${paths%?}" ]; then
	image gallery "${paths%?}"
elif [ $# -eq 1 ]; then
	image open "${paths%?}"
else
	image openset "$paths"
fi
