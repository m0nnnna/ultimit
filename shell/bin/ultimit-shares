#!/bin/sh
# ultimit-shares [--new FOLDER] - open SHARES, the file share maker. With --new, the "New share" dialog opens
# prefilled with FOLDER. SHARES is its own quickshell process (shares-shell.qml), started here when not yet
# running; it exits when its window closes.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/shares-shell.qml"

shares() { qs -p "$cfg" ipc call shares "$@" >/dev/null 2>&1; }

if ! shares state; then
    qs -p "$cfg" -n -d >/dev/null 2>&1
    i=0
    until shares state; do
        i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-shares: SHARES did not start" >&2; exit 1; }
        sleep 0.2
    done
fi

if [ "$1" = "--new" ] && [ -n "$2" ]; then
    case "$2" in file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${2#file://}");; *) p=$2;; esac
    case "$p" in /*) ;; *) p="$PWD/$p";; esac
    shares newShare "$p"
else
    shares open
fi
