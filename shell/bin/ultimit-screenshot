#!/bin/sh
# Ultimit screenshots. Bound in the compositor:
#   Super+Shift+S  -> ultimit-screenshot area    (drag to pick a region)
#   Print          -> ultimit-screenshot full
# Saves to ~/Pictures/Screenshots, copies the image to the clipboard and
# shows a toast.
mode=${1:-area}
SHELL_DIR=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
dir="$(xdg-user-dir PICTURES 2>/dev/null || echo "$HOME/Pictures")/Screenshots"
mkdir -p "$dir"
file="$dir/Ultimit_$(date +%Y-%m-%d_%H-%M-%S).png"

case "$mode" in
area)
	geom=$(slurp -d -b '#05060799' -c '#d4ebffff' -s '#d4ebff22' -w 2) || exit 0 # Esc cancels
	grim -g "$geom" "$file" || exit 1
	;;
full)
	grim "$file" || exit 1
	;;
*)
	echo "usage: ultimit-screenshot [area|full]" >&2
	exit 2
	;;
esac

wl-copy --type image/png <"$file"
qs -p "$SHELL_DIR" ipc call toasts show "Screenshot" "Copied to clipboard · saved to ${file#$HOME/}" >/dev/null 2>&1 || true
