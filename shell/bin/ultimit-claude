#!/bin/sh
# ultimit-claude [--troubleshoot | FOLDER] - open CLAUDE, the Ultimit Claude app. --troubleshoot opens the
# built-in "This PC" project (troubleshooting, with the system summary); FOLDER opens the project for that
# folder, or offers to make one. CLAUDE is its own quickshell process (claude-shell.qml), started here
# when not yet running; it exits when its window closes.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/claude-shell.qml"
# Started from a launcher or xdg-open, PATH can lack Ultimit's bin dir: find qs like ultimit-data.
QS=$(command -v qs) || for q in "$shell/../bin/qs" "${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}/bin/qs"; do
	[ -x "$q" ] && QS=$q && break
done
QS=${QS:-qs}

claude() { "$QS" -p "$cfg" ipc call claude "$@" >/dev/null 2>&1; }

if ! claude state; then
	"$QS" -p "$cfg" -n -d >/dev/null 2>&1
	i=0
	until claude state; do
		i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-claude: CLAUDE did not start" >&2; exit 1; }
		sleep 0.2
	done
fi

case "$1" in
--troubleshoot) claude troubleshoot ;;
"") claude open ;;
*)
	p=$1
	case "$p" in file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${p#file://}");; esac
	case "$p" in /*) ;; *) p="$PWD/$p";; esac
	[ -f "$p" ] && p=$(dirname "$p")
	[ "$p" = / ] || p=${p%/}
	claude folder "$p"
	;;
esac
