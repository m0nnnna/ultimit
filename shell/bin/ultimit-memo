#!/bin/sh
# ultimit-memo [FILE...] - open each file in its own MEMO window; no argument: a new untitled document.
# MEMO is its own quickshell process (memo-shell.qml), started here when not yet running, so
# desktop-shell reloads or crashes never lose unsaved text. It exits when its last window closes.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/memo-shell.qml"

memo() { qs -p "$cfg" ipc call memo "$@" >/dev/null 2>&1; }

started=0
if ! memo state; then
    started=1
    qs -p "$cfg" -n -d >/dev/null 2>&1
    i=0
    until memo state; do
        i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-memo: MEMO did not start" >&2; exit 1; }
        sleep 0.2
    done
fi

if [ $# -eq 0 ]; then
    # A fresh start that restored drafts already shows them; no extra Untitled.
    [ $started = 1 ] && [ "$(qs -p "$cfg" ipc call memo state 2>/dev/null)" != "[]" ] && exit 0
    memo create
    exit
fi
for p in "$@"; do
    case "$p" in file://*) p=$(python3 -c 'import sys, urllib.parse; print(urllib.parse.unquote(sys.argv[1]))' "${p#file://}");; esac
    case "$p" in /*) ;; *) p="$PWD/$p";; esac
    memo open "$p"
done
