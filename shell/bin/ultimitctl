#!/usr/bin/env python3
"""ultimitctl: talk to the Ultimit compositor's control socket.

  ultimitctl state                 JSON: outputs, windows, layer surfaces
  ultimitctl windows               one line per window (id, app, flags, frame)
  ultimitctl focus|close|maximize|fullscreen|minimize ID
  ultimitctl move ID X Y | resize ID W H
  ultimitctl snap ID left|right|restore|maximize
                                   tile a window (repeat left/right: 1/2, 1/3, 2/3)
  ultimitctl primary OUTPUT          make OUTPUT the main display
  ultimitctl test-output add W H | remove NAME
                                   test hook: plug / unplug a virtual monitor (headless)
  ultimitctl motion on|off         window animations on/off (the shell sends its motion setting)
  ultimitctl skin PANEL FG DIM LINE LINE_STRONG ACCENT BAD [FONT FAMILY]
                                   window chrome colors (#rrggbb[aa]) and title font; the shell sends these
  ultimitctl keys                  JSON: every compositor keybinding (for cheat sheets)
  ultimitctl release-keys          release keys stuck "held" (a lost key-up after resume)
  ultimitctl events                stream compositor events (Alt+Tab switcher), one JSON per line
  ultimitctl drag ID X Y | drag-release
                                   test hook: drag a titlebar to layout X,Y / drop it

Finds the socket from $WAYLAND_DISPLAY ($XDG_RUNTIME_DIR/ultimit-$WAYLAND_DISPLAY.sock),
else $ULTIMIT_SOCK.
"""
import json
import os
import socket
import sys


def sock_path():
    # WAYLAND_DISPLAY wins: ULTIMIT_SOCK is inherited by everything started in
    # a session, so it would point a script aimed at a devbox back at the
    # session it was launched from.
    runtime = os.environ.get("XDG_RUNTIME_DIR", "/tmp")
    display = os.environ.get("WAYLAND_DISPLAY")
    if display:
        path = os.path.join(runtime, "ultimit-%s.sock" % display)
        if os.path.exists(path):
            return path
    if os.environ.get("ULTIMIT_SOCK"):
        return os.environ["ULTIMIT_SOCK"]
    return os.path.join(runtime, "ultimit-wayland-0.sock")


def call(line):
    with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
        s.connect(sock_path())
        s.sendall((line + "\n").encode())
        data = b""
        while not data.endswith(b"\n"):
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
    return json.loads(data)


def main(argv):
    if not argv or argv[0] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    if argv[0] == "windows":
        for w in call("state")["windows"]:
            flags = [k for k in ("focused", "ssd", "minimized", "maximized", "fullscreen") if w[k]]
            if w.get("snapped"):
                flags.append("snapped-" + w["snapped"])
            f = w["frame"]
            print("%-3d %-28s %-22s frame=%d,%d %dx%d" % (
                w["id"], w["app_id"][:28], ",".join(flags), f["x"], f["y"], f["width"], f["height"]))
        return 0
    if argv[0] == "events":
        with socket.socket(socket.AF_UNIX, socket.SOCK_STREAM) as s:
            s.connect(sock_path())
            s.sendall(b"subscribe\n")
            for line in s.makefile("r"):
                print(line, end="", flush=True)
        return 0
    reply = call(" ".join(argv))
    print(json.dumps(reply, indent=2 if argv[0] in ("state", "keys") else None))
    return 1 if "error" in reply else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
