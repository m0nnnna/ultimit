#!/bin/sh
# ultimit-broadcast [--tab mic|speakers|camera] | --restore - open BROADCAST, the mic / speaker / camera effects app.
# --restore: no window, re-apply the saved microphone and speaker presets and start the camera engine only if the
# virtual camera was left on (run once per login by the session; never opens a window).
# BROADCAST is its own quickshell process (broadcast-shell.qml), started here when not yet running; it exits when
# its window closes. The engines (EasyEffects, OBS Studio) are started in the background by the backend.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/broadcast-shell.qml"

if [ "$1" = "--restore" ]; then
    exec python3 "$shell/apps/broadcast/broadcast.py" restore
fi

bc() { qs -p "$cfg" ipc call broadcast "$@" >/dev/null 2>&1; }

if ! bc state; then
    qs -p "$cfg" -n -d >/dev/null 2>&1
    i=0
    until bc state; do
        i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-broadcast: BROADCAST did not start" >&2; exit 1; }
        sleep 0.2
    done
fi

if [ "$1" = "--tab" ] && [ -n "$2" ]; then
    bc showTab "$2"
else
    bc open
fi
