#!/bin/sh
# ultimit-store [--search WORDS | --app ID | --installed] - open STORE, the app store over Flathub.
# --search opens it on the results for WORDS, --app on one app (a Flatpak id), --installed on the
# installed apps. STORE is its own quickshell process (store-shell.qml), started here when not yet
# running; it exits when its window closes and no install is running.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/store-shell.qml"

store() { qs -p "$cfg" ipc call store "$@" >/dev/null 2>&1; }

if ! store state; then
    qs -p "$cfg" -n -d >/dev/null 2>&1
    i=0
    until store state; do
        i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-store: STORE did not start" >&2; exit 1; }
        sleep 0.2
    done
fi

case "$1" in
    --search) store search "$2" ;;
    --app) store app "$2" ;;
    --installed) store installed ;;
    *) store open ;;
esac
