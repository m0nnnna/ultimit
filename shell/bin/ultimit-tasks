#!/bin/sh
# ultimit-tasks [--performance] - open TASKS, the task manager. --performance opens it on the PERFORMANCE tab.
# TASKS is its own quickshell process (tasks-shell.qml), started here when not yet running; it exits when its
# window closes.
shell="${ULTIMIT_SHELL_DIR:-$(dirname "$(dirname "$(readlink -f "$0")")")}"
cfg="$shell/tasks-shell.qml"

tasks() { qs -p "$cfg" ipc call tasks "$@" >/dev/null 2>&1; }

if ! tasks state; then
    qs -p "$cfg" -n -d >/dev/null 2>&1
    i=0
    until tasks state; do
        i=$((i + 1)); [ $i -gt 50 ] && { echo "ultimit-tasks: TASKS did not start" >&2; exit 1; }
        sleep 0.2
    done
fi

if [ "$1" = "--performance" ]; then
    tasks performance
else
    tasks open
fi
