#!/bin/sh
# Secret Service for Ultimit sessions: oo7-daemon instead of gnome-keyring.
#
# GDM's PAM stack still starts gnome-keyring at login (until GNOME is
# removed), so stop it for this session and let oo7 own
# org.freedesktop.secrets. oo7 imports the existing GNOME keyring the first
# time it is unlocked (with the login password, asked once via the
# SystemPrompter dialog unless PAM already unlocked it), keeping the old
# file as *.migrated. The Ubuntu session is unaffected.
DEPS=${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}
command -v "$DEPS/bin/oo7-daemon" >/dev/null || exit 0

systemctl --user stop gnome-keyring-daemon.service gnome-keyring-daemon.socket 2>/dev/null
# The PAM-started instance isn't a systemd unit; stop only this user's.
for pid in $(pgrep -u "$(id -u)" -x gnome-keyring-d); do
	kill "$pid" 2>/dev/null
done

exec "$DEPS/bin/oo7-daemon" --replace
