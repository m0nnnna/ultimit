#!/bin/sh
# Login-screen entry point for Ultimit. Started by the login screen (the Ultimit greeter on greetd,
# or GDM) from /usr/share/wayland-sessions/ultimit.desktop.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
# Installed (scripts/install.sh: /opt/ultimit, with bin/ and lib/ beside session/ and shell/) or
# a development checkout (compositor/build/, deps from ULTIMIT_DEPS, else ~/.local/ultimit-deps).
if [ -x "$ROOT/bin/ultimit" ]; then
	DEPS=${ULTIMIT_DEPS:-$ROOT}
	COMPOSITOR=$ROOT/bin/ultimit
else
	DEPS=${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}
	COMPOSITOR=$ROOT/compositor/build/ultimit
fi
export ULTIMIT_DEPS=$DEPS
# The version this session started with (Settings > Updates: "log out to finish" after an update)
[ -f "$ROOT/VERSION" ] && ULTIMIT_VERSION=$(cat "$ROOT/VERSION") && export ULTIMIT_VERSION

export XDG_CURRENT_DESKTOP=Ultimit
export XDG_SESSION_DESKTOP=ultimit
export XDG_SESSION_TYPE=wayland
export PATH="$DEPS/bin:$ROOT/shell/bin:$HOME/.local/bin:$PATH"

# Flatpak apps (Ungoogled Chromium): their desktop entries and icons live
# in the export dirs, which only a login shell's profile.d would add.
for d in "$HOME/.local/share/flatpak/exports/share" /var/lib/flatpak/exports/share; do
	case ":${XDG_DATA_DIRS:=/usr/local/share:/usr/share}:" in
	*":$d:"*) ;;
	*) XDG_DATA_DIRS="$d:$XDG_DATA_DIRS" ;;
	esac
done
export XDG_DATA_DIRS

# Ultimit GTK theme for apps that draw their own titlebars (GNOME apps).
# Only set here, so the regular Ubuntu session is unaffected.
"$ROOT/shell/theme/install-gtk-theme.sh" >/dev/null 2>&1 || true
# Ultimit icon themes (one per skin), rebuilt each login so they follow the repo.
"$ROOT/shell/theme/icons/install-icons.sh" >/dev/null 2>&1 || true
# fastfetch in Ultimit's look, coloured for the skin (unless the user owns the config).
"$ROOT/session/ultimit-fastfetch-config" >/dev/null 2>&1 || true
# Shard cursor themes (one per skin); skipped when unchanged.
"$ROOT/shell/theme/cursors/install-cursors.sh" >/dev/null 2>&1 || true
. "$ROOT/shell/theme/session-env.sh"
# Apps that don't inherit this environment read the themes from gsettings.
case "$QS_ICON_THEME" in Ultimit-*) gsettings set org.gnome.desktop.interface icon-theme "$QS_ICON_THEME" 2>/dev/null ;; esac
gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" 2>/dev/null
[ -n "$XCURSOR_THEME" ] && gsettings set org.gnome.desktop.interface cursor-theme "$XCURSOR_THEME" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-size "${XCURSOR_SIZE:-24}" 2>/dev/null
gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' 2>/dev/null
# Font rendering (GNOME's settings daemon used to supply it): greyscale, light hinting.
# GTK apps and Chromium read these through the settings portal.
gsettings set org.gnome.desktop.interface font-antialiasing grayscale 2>/dev/null
gsettings set org.gnome.desktop.interface font-hinting slight 2>/dev/null
gsettings set org.gnome.desktop.interface font-rgba-order rgb 2>/dev/null
# Dark or light per skin; sandboxed apps (Flatpak) and Chromium read it through the portal.
gsettings set org.gnome.desktop.interface color-scheme "$ADW_DEBUG_COLOR_SCHEME" 2>/dev/null
# Flatpak apps: the Ultimit theme instead of Adwaita, and Chromium's GTK theme + system titlebar.
"$ROOT/session/ultimit-flatpak-theme" >/dev/null 2>&1 || true
# Discord (Vesktop): a launcher entry per account, each running on its own; the Ultimit theme.
("$ROOT/shell/bin/ultimit-discord" setup >/dev/null 2>&1 &)

# Tell xdg-desktop-portal which backends serve an Ultimit desktop. Without
# this, GTK apps wait on portal timeouts at startup (slow launches).
mkdir -p "$HOME/.config/xdg-desktop-portal"
cp "$ROOT/session/portals/ultimit-portals.conf" "$HOME/.config/xdg-desktop-portal/"

# Ultimit-styled configs for the terminal (foot) and PDF viewer (zathura),
# and font rendering for every app (fontconfig; Flatpak
# apps get a copy from ultimit-flatpak-theme). Installed only where missing or
# still marked "Managed by Ultimit", so the user's own edits are never overwritten.
for f in foot/foot.ini zathura/zathurarc fontconfig/60-ultimit.conf; do
	dst="$HOME/.config/$f"
	case "$f" in fontconfig/*) dst="$HOME/.config/fontconfig/conf.d/${f#fontconfig/}" ;; esac
	if [ ! -e "$dst" ] || head -n1 "$dst" | grep -q "Managed by Ultimit"; then
		mkdir -p "$(dirname "$dst")"
		cp "$ROOT/session/defaults/$f" "$dst"
	fi
done

# Clean mic (stands in for NVIDIA Broadcast's noise removal): EasyEffects
# (Flatpak; Ubuntu's build lacks RNNoise) runs in the background at login
# with RNNoise on every app's mic input. Set up once; after that,
# EasyEffects' own settings decide.
ee_app=com.github.wwmm.easyeffects
ee_mark="$HOME/.local/state/ultimit/easyeffects-setup"
if [ ! -e "$ee_mark" ] && flatpak info "$ee_app" >/dev/null 2>&1; then
	ee_presets="$HOME/.var/app/$ee_app/data/easyeffects/input"
	mkdir -p "$ee_presets" "$HOME/.config/autostart" "$(dirname "$ee_mark")"
	cp --update=none "$ROOT"/session/defaults/easyeffects/*.json "$ee_presets/"
	cp --update=none "$ROOT/session/defaults/easyeffects/easyeffects-service.desktop" "$HOME/.config/autostart/"
	(sleep 8; flatpak run "$ee_app" -l "Clean Mic" >/dev/null 2>&1) &
	touch "$ee_mark"
fi

# Ultimit's own apps (DATA, ...) as desktop entries, so xdg-open and other
# apps' "open folder" find them. Exec gets this checkout's absolute path.
mkdir -p "$HOME/.local/share/applications"
for d in "$ROOT"/shell/apps/*/ultimit-*.desktop; do
	[ -e "$d" ] || continue
	sed "s|^Exec=ultimit-|Exec=$ROOT/shell/bin/ultimit-|" "$d" \
		>"$HOME/.local/share/applications/$(basename "$d")"
done
# Folders open in DATA (xdg-open, the portal's "open folder") unless the
# user picked a file manager that is still installed (Settings > Default apps).
fm=$(xdg-mime query default inode/directory 2>/dev/null) fm_ok=""
for d in "$HOME/.local/share" $(echo "$XDG_DATA_DIRS" | tr : ' '); do
	[ -n "$fm" ] && [ -e "$d/applications/$fm" ] && fm_ok=1
done
[ -n "$fm_ok" ] || xdg-mime default ultimit-data.desktop inode/directory 2>/dev/null
# Pictures open in IMAGE, once per user (in the background: xdg-mime is slow): every picture type
# whose viewer is unset, uninstalled or imv (Ultimit's viewer before IMAGE). After that the choices
# in Settings > Default apps stand.
img_mark="$HOME/.local/state/ultimit/image-default"
if [ ! -e "$img_mark" ]; then
	(
		img_set=""
		for t in $(sed -n 's/^MimeType=//p' "$ROOT/shell/apps/image/ultimit-image.desktop" | tr ';' ' '); do
			v=$(xdg-mime query default "$t" 2>/dev/null) keep=""
			case "$v" in "" | imv.desktop | imv-dir.desktop) ;; *)
				for d in "$HOME/.local/share" $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr : ' '); do
					[ -e "$d/applications/$v" ] && keep=1
				done ;;
			esac
			[ -n "$keep" ] || img_set="$img_set $t"
		done
		[ -z "$img_set" ] || xdg-mime default ultimit-image.desktop $img_set 2>/dev/null
		mkdir -p "$(dirname "$img_mark")" && touch "$img_mark"
	) &
fi

# mailto: links open NekoMail when no mail app is set, or the one set was uninstalled
# (Settings > Default apps changes it)
if [ -e /usr/share/applications/nekomail.desktop ] || [ -e "$HOME/.local/share/applications/nekomail.desktop" ]; then
	(
		v=$(xdg-mime query default x-scheme-handler/mailto 2>/dev/null) keep=""
		for d in "$HOME/.local/share" $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr : ' '); do
			[ -n "$v" ] && [ -e "$d/applications/$v" ] && keep=1
		done
		[ -n "$keep" ] || xdg-mime default nekomail.desktop x-scheme-handler/mailto 2>/dev/null
	) &
fi

# Music opens in NekoPlayer, once per user (in the background: xdg-mime is slow): every audio
# type whose player is unset, uninstalled or mpv (Ultimit's player before NekoPlayer; it stays
# the video player). After that the choices in Settings > Default apps stand.
aud_mark="$HOME/.local/state/ultimit/audio-default"
if [ ! -e "$aud_mark" ] && { [ -e /usr/share/applications/nekoplayer.desktop ] || [ -e "$HOME/.local/share/applications/nekoplayer.desktop" ]; }; then
	(
		set_types=""
		for t in audio/mpeg audio/mp3 audio/flac audio/x-flac audio/ogg audio/x-vorbis+ogg audio/opus audio/x-opus+ogg \
			audio/wav audio/x-wav audio/vnd.wave audio/aac audio/mp4 audio/x-m4a; do
			v=$(xdg-mime query default "$t" 2>/dev/null) keep=""
			case "$v" in "" | mpv.desktop | io.mpv.Mpv.desktop) ;; *)
				for d in "$HOME/.local/share" $(echo "${XDG_DATA_DIRS:-/usr/local/share:/usr/share}" | tr : ' '); do
					[ -e "$d/applications/$v" ] && keep=1
				done ;;
			esac
			[ -n "$keep" ] || set_types="$set_types $t"
		done
		[ -z "$set_types" ] || xdg-mime default nekoplayer.desktop $set_types 2>/dev/null
		mkdir -p "$(dirname "$aud_mark")" && touch "$aud_mark"
	) &
fi

# Keep a log of the last session for debugging; the previous one is kept too.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ultimit"
mkdir -p "$LOG_DIR"
[ -f "$LOG_DIR/session.log" ] && mv "$LOG_DIR/session.log" "$LOG_DIR/session.log.old"
# NVIDIA: DLSS in Proton games uses NVIDIA's newest DLSS (the driver's updater fetches it) and its
# newest preset instead of the old one a game ships; an old one can drop meshes (AION 2's legs).
# Steam inherits these. A game that misbehaves opts out with PROTON_DISABLE_NVAPI=1 %command%.
if [ -d /proc/driver/nvidia ]; then
	export PROTON_ENABLE_NGX_UPDATER="${PROTON_ENABLE_NGX_UPDATER:-1}"
	export DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE="${DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE:-on}"
	export DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION="${DXVK_NVAPI_DRS_NGX_DLSS_SR_OVERRIDE_RENDER_PRESET_SELECTION:-render_preset_latest}"
fi
# Flatpak apps: NVIDIA's graphics libraries for the running driver (else no GPU in Chromium).
("$ROOT/session/ultimit-flatpak-gpu" >"$LOG_DIR/flatpak-gpu.log" 2>&1 &)
# Ungoogled Chromium: spell-check dictionaries (it can't download its own, so nothing gets underlined).
("$ROOT/session/ultimit-spellcheck" >"$LOG_DIR/spellcheck.log" 2>&1 &)

# Touchscreen (phones): an on-screen keyboard, hidden until the tray's keyboard button shows it.
OSK=""
if grep -qi touchscreen /proc/bus/input/devices 2>/dev/null && command -v wvkbd-mobintl >/dev/null; then
	export ULTIMIT_OSK=1
	OSK="(stdbuf -oL wvkbd-mobintl --hidden -o --press 3d7dd8 --press-sp 3d7dd8 -H 480 -L 300 --fn 'Sans 24' 2>/dev/null | '$ROOT/session/ultimit-osk-feedback' &); ('$ROOT/session/ultimit-autorotate' >/dev/null 2>&1 &); "
fi

# Once the compositor is up: hand the display variables to systemd/D-Bus so
# apps they launch (portals, notifications, file pickers) find this session,
# stop any portal that started too early without them (it restarts on
# demand with the right environment), then start the shell.
STARTUP="dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS GTK_THEME ADW_DEBUG_COLOR_SCHEME QS_ICON_THEME SSH_AUTH_SOCK XCURSOR_THEME XCURSOR_SIZE; systemctl --user stop xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr 2>/dev/null; ('$ROOT/session/ultimit-portal-watch' &); systemctl --user start nekomail.service 2>/dev/null; ('$ROOT/session/ultimit-secrets' &); ('$ROOT/session/ultimit-greeter-displays' &); ('$ROOT/session/ultimit-filemanager1' >/dev/null 2>&1 &); ('$ROOT/session/ultimit-automount' &); ((sleep 15; '$ROOT/shell/bin/ultimit-shares' --reconnect) >/dev/null 2>&1 &); ((sleep 20; '$ROOT/shell/bin/ultimit-broadcast' --restore) >/dev/null 2>&1 &); ('$ROOT/shell/bin/ultimit-agents' &); $OSK'$ROOT/session/ultimit-autostart'; '$ROOT/session/ultimit-shell'"

# Hybrid laptops: render the desktop on the GPU that drives the built-in
# panel (Intel/AMD), keeping the NVIDIA card free for games (PRIME offload)
# and its own outputs. Without this wlroots may pick NVIDIA and copy every
# frame across. Card numbers change between boots, so look them up here.
# Opt out: touch ~/.config/ultimit/no-igpu-first
if [ -z "${WLR_DRM_DEVICES:-}" ] && [ ! -e "$HOME/.config/ultimit/no-igpu-first" ]; then
	primary="" others=""
	for c in /sys/class/drm/card[0-9]*; do
		case "$c" in *-*) continue ;; esac
		[ -e "$c/device/driver" ] || continue
		drv=$(basename "$(readlink -f "$c/device/driver")")
		dev="/dev/dri/$(basename "$c")"
		if [ -z "$primary" ] && [ "$drv" != nvidia ] && \
				grep -qx connected "$c"/"$(basename "$c")"-eDP-*/status 2>/dev/null; then
			primary=$dev
		else
			others="$others:$dev"
		fi
	done
	[ -n "$primary" ] && [ -n "$others" ] && export WLR_DRM_DEVICES="$primary$others"
fi

# Runs the compositor, keeps crash reports and restarts it after a crash (see that script).
exec "$ROOT/session/ultimit-run-compositor" "$COMPOSITOR" "$STARTUP" "$LOG_DIR"
