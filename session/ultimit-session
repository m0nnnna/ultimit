#!/bin/sh
# Login-screen entry point for Ultimit. Started by GDM (or any display
# manager) from /usr/share/wayland-sessions/ultimit.desktop.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
DEPS=${ULTIMIT_DEPS:-$HOME/.local/ultimit-deps}

export XDG_CURRENT_DESKTOP=Ultimit
export XDG_SESSION_DESKTOP=ultimit
export XDG_SESSION_TYPE=wayland
export PATH="$DEPS/bin:$ROOT/shell/bin:$HOME/.local/bin:$PATH"

# Flatpak apps (Ungoogled Chromium): their desktop entries and icons live
# in the export dirs, which only a login shell's profile.d would add.
for d in "$HOME/.local/share/flatpak/exports/share" /var/lib/flatpak/exports/share; do
	case ":${XDG_DATA_DIRS:=/usr/local/share:/usr/share}:" in
	*":$d:"*) ;;
	*) XDG_DATA_DIRS="$d:$XDG_DATA_DIRS" ;;
	esac
done
export XDG_DATA_DIRS

# Ultimit GTK theme for apps that draw their own titlebars (GNOME apps).
# Only set here, so the regular Ubuntu session is unaffected.
"$ROOT/shell/theme/install-gtk-theme.sh" >/dev/null 2>&1 || true
# Ultimit icon themes (one per skin), rebuilt each login so they follow the repo.
"$ROOT/shell/theme/icons/install-icons.sh" >/dev/null 2>&1 || true
# fastfetch in Ultimit's look, coloured for the skin (unless the user owns the config).
"$ROOT/session/ultimit-fastfetch-config" >/dev/null 2>&1 || true
# Shard cursor themes (one per skin); skipped when unchanged.
"$ROOT/shell/theme/cursors/install-cursors.sh" >/dev/null 2>&1 || true
. "$ROOT/shell/theme/session-env.sh"
# Apps that don't inherit this environment read the themes from gsettings.
case "$QS_ICON_THEME" in Ultimit-*) gsettings set org.gnome.desktop.interface icon-theme "$QS_ICON_THEME" 2>/dev/null ;; esac
gsettings set org.gnome.desktop.interface gtk-theme "$GTK_THEME" 2>/dev/null
[ -n "$XCURSOR_THEME" ] && gsettings set org.gnome.desktop.interface cursor-theme "$XCURSOR_THEME" 2>/dev/null
gsettings set org.gnome.desktop.interface cursor-size "${XCURSOR_SIZE:-24}" 2>/dev/null
gsettings set org.gnome.desktop.wm.preferences button-layout ':minimize,maximize,close' 2>/dev/null

# Tell xdg-desktop-portal which backends serve an Ultimit desktop. Without
# this, GTK apps wait on portal timeouts at startup (slow launches).
mkdir -p "$HOME/.config/xdg-desktop-portal"
cp "$ROOT/session/portals/ultimit-portals.conf" "$HOME/.config/xdg-desktop-portal/"

# Ultimit-styled configs for the terminal (foot), PDF viewer (zathura) and
# image viewer (imv). Installed only where missing or still marked
# "Managed by Ultimit", so the user's own edits are never overwritten.
for f in foot/foot.ini zathura/zathurarc imv/config; do
	dst="$HOME/.config/$f"
	if [ ! -e "$dst" ] || head -n1 "$dst" | grep -q "Managed by Ultimit"; then
		mkdir -p "$(dirname "$dst")"
		cp "$ROOT/session/defaults/$f" "$dst"
	fi
done

# Ultimit's own apps (DATA, ...) as desktop entries, so xdg-open and other
# apps' "open folder" find them. Exec gets this checkout's absolute path.
mkdir -p "$HOME/.local/share/applications"
for d in "$ROOT"/shell/apps/*/ultimit-*.desktop; do
	[ -e "$d" ] || continue
	sed "s|^Exec=ultimit-|Exec=$ROOT/shell/bin/ultimit-|" "$d" \
		>"$HOME/.local/share/applications/$(basename "$d")"
done

# Keep a log of the last session for debugging; the previous one is kept too.
LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/ultimit"
mkdir -p "$LOG_DIR"
[ -f "$LOG_DIR/session.log" ] && mv "$LOG_DIR/session.log" "$LOG_DIR/session.log.old"

# Once the compositor is up: hand the display variables to systemd/D-Bus so
# apps they launch (portals, notifications, file pickers) find this session,
# stop any portal that started too early without them (it restarts on
# demand with the right environment), then start the shell.
STARTUP="dbus-update-activation-environment --systemd WAYLAND_DISPLAY DISPLAY XDG_CURRENT_DESKTOP XDG_SESSION_TYPE XDG_DATA_DIRS GTK_THEME ADW_DEBUG_COLOR_SCHEME QS_ICON_THEME SSH_AUTH_SOCK XCURSOR_THEME XCURSOR_SIZE; systemctl --user stop xdg-desktop-portal xdg-desktop-portal-gtk xdg-desktop-portal-wlr 2>/dev/null; ('$ROOT/session/ultimit-portal-watch' &); systemctl --user start nekomail.service 2>/dev/null; ('$ROOT/session/ultimit-secrets' &); ('$ROOT/shell/bin/ultimit-agents' &); '$ROOT/session/ultimit-autostart'; '$ROOT/session/ultimit-shell'"

# Hybrid laptops: render the desktop on the GPU that drives the built-in
# panel (Intel/AMD), keeping the NVIDIA card free for games (PRIME offload)
# and its own outputs. Without this wlroots may pick NVIDIA and copy every
# frame across. Card numbers change between boots, so look them up here.
# Opt out: touch ~/.config/ultimit/no-igpu-first
if [ -z "${WLR_DRM_DEVICES:-}" ] && [ ! -e "$HOME/.config/ultimit/no-igpu-first" ]; then
	primary="" others=""
	for c in /sys/class/drm/card[0-9]*; do
		case "$c" in *-*) continue ;; esac
		[ -e "$c/device/driver" ] || continue
		drv=$(basename "$(readlink -f "$c/device/driver")")
		dev="/dev/dri/$(basename "$c")"
		if [ -z "$primary" ] && [ "$drv" != nvidia ] && \
				grep -qx connected "$c"/"$(basename "$c")"-eDP-*/status 2>/dev/null; then
			primary=$dev
		else
			others="$others:$dev"
		fi
	done
	[ -n "$primary" ] && [ -n "$others" ] && export WLR_DRM_DEVICES="$primary$others"
fi

# Lets scripts/restart-session.sh find this session's compositor (exec keeps the pid).
echo $$ >"${XDG_RUNTIME_DIR:-/tmp}/ultimit-session.pid"

exec "$ROOT/compositor/build/ultimit" -s "$STARTUP" >"$LOG_DIR/session.log" 2>&1
