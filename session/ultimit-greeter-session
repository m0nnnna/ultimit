#!/bin/sh
# Run by greetd as its greeter user (/etc/greetd/config.toml, scripts/install.sh): the Ultimit
# compositor with the login screen as its only client. When the greeter quits (after starting a
# session), the compositor exits (-x) and greetd takes over. Installed at
# /opt/ultimit/session/ultimit-greeter-session; everything is found relative to that.
ROOT=$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)
export LD_LIBRARY_PATH="$ROOT/lib/$(uname -m)-linux-gnu${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"
export XDG_CURRENT_DESKTOP=Ultimit XDG_SESSION_TYPE=wayland
export QT_QPA_PLATFORM=wayland
# Hinted text like the session (see ultimit-shell)
export QML_DISABLE_DISTANCEFIELD=1
# The greeter user may have no writable home; keep Quickshell's state in the runtime dir and the
# remembered user/session in /var/lib/ultimit-greeter.
export XDG_CACHE_HOME="${XDG_RUNTIME_DIR:-/tmp}/ultimit-greeter/cache"
export XDG_STATE_HOME=/var/lib/ultimit-greeter
mkdir -p "$XDG_CACHE_HOME"
# The monitor setup of the user who logged in last (their session leaves a copy here, see
# ultimit-greeter-displays): which screen is the main one, modes, rotation. Only a copy that user owns.
DISPLAYS=/var/lib/ultimit-greeter/displays
mkdir -p "$DISPLAYS" 2>/dev/null && chmod 1777 "$DISPLAYS" 2>/dev/null
last=$(sed -n 's/^user=//p' "$XDG_STATE_HOME/ultimit-greeter/state" 2>/dev/null | head -n 1)
case "$last" in "" | */* | .*) last="" ;; esac
if [ -n "$last" ] && [ -f "$DISPLAYS/$last.conf" ] && [ "$(stat -c %U "$DISPLAYS/$last.conf")" = "$last" ]; then
	export XDG_CONFIG_HOME="${XDG_RUNTIME_DIR:-/tmp}/ultimit-greeter/config"
	mkdir -p "$XDG_CONFIG_HOME/ultimit"
	cp "$DISPLAYS/$last.conf" "$XDG_CONFIG_HOME/ultimit/displays.conf"
fi
# Hybrid laptops: draw on the GPU that drives the built-in panel (as ultimit-session does).
if [ -z "${WLR_DRM_DEVICES:-}" ]; then
	primary="" others=""
	for c in /sys/class/drm/card[0-9]*; do
		case "$c" in *-*) continue ;; esac
		[ -e "$c/device/driver" ] || continue
		drv=$(basename "$(readlink -f "$c/device/driver")")
		dev="/dev/dri/$(basename "$c")"
		if [ -z "$primary" ] && [ "$drv" != nvidia ] && \
				grep -qx connected "$c"/"$(basename "$c")"-eDP-*/status 2>/dev/null; then
			primary=$dev
		else
			others="$others:$dev"
		fi
	done
	[ -n "$primary" ] && [ -n "$others" ] && export WLR_DRM_DEVICES="$primary$others"
fi
# Touchscreen and no keyboard to type with (phones): an on-screen keyboard beside the login screen.
osk=""
if grep -qi touchscreen /proc/bus/input/devices 2>/dev/null && command -v wvkbd-mobintl >/dev/null; then
	osk="wvkbd-mobintl & "
	export ULTIMIT_OSK=1
fi
exec "$ROOT/bin/ultimit" -x -s "$osk exec $ROOT/bin/qs -p $ROOT/greeter"
