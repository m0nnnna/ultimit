#!/usr/bin/env python3
"""Spell-check dictionaries for Chromium-based Flatpak browsers.

Chromium does not use the system's hunspell dictionaries: it downloads its own
(.bdic files) into <profile root>/Dictionaries the first time spell check runs.
Ungoogled Chromium blocks that download (it rewrites Google's domains), so
spell check stays on in its settings but never underlines anything. This puts
the dictionaries there instead, from the same place Chromium fetches them.

Languages: those each profile has in Settings > Languages > Spell check, plus
the session's language ($LANG), English (US) when neither gives one. Files
already there are kept, so after the first run this is a no-op (no network).
Run in the background at every login by ultimit-session (and by
scripts/setup-browser.sh). A browser started before a dictionary arrived picks
it up when it is restarted.
"""
import base64
import json
import os
import re
import subprocess
import sys
import urllib.request

# Flatpak app id -> its Chromium config dir under ~/.var/app/ID/config (browsers
# that can't download their own dictionaries)
BROWSERS = {
    "io.github.ungoogled_software.ungoogled_chromium": "chromium",
}
# Where Chromium downloads them (lower-case names), and the source repository it
# builds them from (also lists which files exist, so the newest version is used).
CDN = "https://redirector.gvt1.com/edgedl/chrome/dict/"
REPO = "https://chromium.googlesource.com/chromium/deps/hunspell_dictionaries/+/HEAD/"
# If the listing can't be fetched: the versions Chromium currently expects.
FALLBACK_VERSIONS = {"en-US": "10-1", "en-GB": "10-1", "en-CA": "10-1", "en-AU": "10-1"}
BDIC = re.compile(r"^([A-Za-z]{2,3}(?:-[A-Za-z]{2,4})?)-(\d+)-(\d+)\.bdic$")


def fetch(url, timeout=30):
    req = urllib.request.Request(url, headers={"User-Agent": "ultimit-spellcheck"})
    with urllib.request.urlopen(req, timeout=timeout) as r:
        return r.read()


def available():
    """{language: newest .bdic file name} from the dictionary repository."""
    try:
        raw = fetch(REPO + "?format=JSON").decode()
        entries = json.loads(raw[raw.index("{"):])["entries"]
    except Exception as e:
        print("listing failed (%s); using built-in versions" % e, file=sys.stderr)
        return {lang: "%s-%s.bdic" % (lang, v) for lang, v in FALLBACK_VERSIONS.items()}
    best = {}
    for e in entries:
        m = BDIC.match(e.get("name", ""))
        if m:
            lang, ver = m.group(1), (int(m.group(2)), int(m.group(3)))
            if lang not in best or ver > best[lang][0]:
                best[lang] = (ver, m.group(0))
    return {lang: name for lang, (ver, name) in best.items()}


def pick(lang, files):
    """Chromium's dictionary for a language tag (en-US, de, pt_BR...), or None."""
    lang = lang.replace("_", "-")
    if lang in files:
        return files[lang]
    base = lang.split("-")[0].lower()
    for cand in (base, "%s-%s" % (base, base.upper()), "en-US" if base == "en" else ""):  # de -> de-DE
        if cand in files:
            return files[cand]
    return None


def download(name):
    try:
        data = fetch(CDN + name.lower())
    except Exception:
        data = b""
    if not data.startswith(b"BDic"):
        try:
            data = base64.b64decode(fetch(REPO + name + "?format=TEXT"))
        except Exception as e:
            print("%s: download failed (%s)" % (name, e), file=sys.stderr)
            return None
    return data if data.startswith(b"BDic") else None


def wanted_languages(root):
    langs = []
    for d in sorted(os.listdir(root)):
        try:
            prefs = json.load(open(os.path.join(root, d, "Preferences")))
        except (OSError, ValueError):
            continue
        langs += prefs.get("spellcheck", {}).get("dictionaries") or []
    env = (os.environ.get("LANG") or "").split(".")[0]
    if env and env not in ("C", "POSIX"):
        langs.append(env)
    return list(dict.fromkeys(langs)) or ["en-US"]


def main():
    try:
        out = subprocess.run(["flatpak", "list", "--app", "--columns=application"],
                             capture_output=True, text=True).stdout
    except OSError:
        return
    installed = set(out.split())
    files = None
    for app, sub in BROWSERS.items():
        if app not in installed:
            continue
        root = os.path.expanduser(os.path.join("~/.var/app", app, "config", sub))
        os.makedirs(root, exist_ok=True)
        dict_dir = os.path.join(root, "Dictionaries")
        have = os.listdir(dict_dir) if os.path.isdir(dict_dir) else []
        for lang in wanted_languages(root):
            tag = lang.replace("_", "-")
            if any(f.startswith(tag + "-") and f.endswith(".bdic") for f in have):
                continue  # already there: no network needed
            if files is None:
                files = available()
            name = pick(lang, files)
            if not name:
                print("%s: no Chromium dictionary" % lang, file=sys.stderr)
                continue
            dst = os.path.join(dict_dir, name)
            if os.path.exists(dst):
                continue
            data = download(name)
            if not data:
                continue
            os.makedirs(dict_dir, exist_ok=True)
            with open(dst + ".tmp", "wb") as f:
                f.write(data)
            os.replace(dst + ".tmp", dst)
            print("%s: %s" % (app, name))


if __name__ == "__main__":
    main()
