#!/usr/bin/env python3
"""Start XDG autostart entries for an Ultimit session.

Ultimit has no GNOME-style session manager, so this does the part we need:
run ~/.config/autostart/*.desktop (and the system ones) that apply to
XDG_CURRENT_DESKTOP=Ultimit, honoring Hidden, OnlyShowIn, NotShowIn and TryExec.
"""
import configparser
import os
import re
import shlex
import shutil
import subprocess

desktop = os.environ.get("XDG_CURRENT_DESKTOP", "Ultimit").split(":")
config_home = os.environ.get("XDG_CONFIG_HOME", os.path.expanduser("~/.config"))
dirs = [os.path.join(config_home, "autostart")] + [
    os.path.join(d, "autostart")
    for d in os.environ.get("XDG_CONFIG_DIRS", "/etc/xdg").split(":")
]

# GNOME tray/notifier helpers and demos that don't belong in an Ultimit session.
SKIP = {
    "geoclue-demo-agent.desktop",
    "org.gnome.Evolution-alarm-notify.desktop",
    "update-notifier.desktop",
    "ubuntu-advantage-notification.desktop",
    "ubuntu-report-on-upgrade.desktop",
    "spice-vdagent.desktop",
}

seen = set(SKIP)
for d in dirs:
    if not os.path.isdir(d):
        continue
    for name in sorted(os.listdir(d)):
        if not name.endswith(".desktop") or name in seen:
            continue
        seen.add(name)  # user entries override system ones with the same name
        cp = configparser.ConfigParser(interpolation=None, strict=False)
        try:
            cp.read(os.path.join(d, name), encoding="utf-8")
            e = cp["Desktop Entry"]
        except Exception:
            continue
        if e.get("Hidden", "false").lower() == "true":
            continue
        only = [x for x in e.get("OnlyShowIn", "").split(";") if x]
        never = [x for x in e.get("NotShowIn", "").split(";") if x]
        if only and not set(only) & set(desktop):
            continue
        if set(never) & set(desktop):
            continue
        if e.get("TryExec") and not shutil.which(e["TryExec"]):
            continue
        cmd = re.sub(r"%[fFuUdDnNickvm]", "", e.get("Exec", "")).strip()
        if not cmd:
            continue
        subprocess.Popen(shlex.split(cmd), start_new_session=True,
                         stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
