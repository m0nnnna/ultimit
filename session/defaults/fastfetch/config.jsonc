// Managed by Ultimit: rewritten at login (colours follow the skin) while this
// line is here. Delete this line to keep your own edits.
{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "file",
    "source": "~/.config/fastfetch/ultimit-logo.txt",
    "color": { "1": "{DIM}", "2": "{ACCENT}", "3": "{ACCENT}" },
    "padding": { "top": 1, "left": 2, "right": 3 }
  },
  "display": {
    "separator": "  ",
    "color": { "keys": "{ACCENT}", "title": "{ACCENT}", "separator": "{DIM}" },
    "key": { "width": 11 },
    "bar": {
      "char": { "elapsed": "▰", "total": "▱" }, "width": 12,
      "color": { "elapsed": "{ACCENT}", "total": "{DIM}", "border": "{DIM}" }
    },
    "percent": { "type": 3, "color": { "green": "{ACCENT}", "yellow": "38;2;255;217;143", "red": "38;2;255;138;138" } }
  },
  "modules": [
    { "type": "title", "format": "{user-name}{at-symbol-colored}{host-name}" },
    { "type": "custom", "format": "{#{DIM}}──────────────────────────────" },
    { "type": "os", "key": "SYSTEM", "format": "Ultimit {VERSION} \"{SKIN}\"  {#{DIM}}on {name} {version-id}" },
    { "type": "kernel", "key": "KERNEL" },
    { "type": "uptime", "key": "UPTIME" },
    { "type": "packages", "key": "PACKAGES" },
    { "type": "shell", "key": "SHELL" },
    { "type": "terminal", "key": "TERMINAL" },
    { "type": "custom", "key": "DESKTOP", "format": "Ultimit  {#{DIM}}Altimit-style · wlroots" },
    { "type": "display", "key": "DISPLAY" },
    { "type": "custom", "key": "SKIN", "format": "{SKIN}  {#{DIM}}GTK {GTK} · icons {ICONS}" },
    { "type": "cpu", "key": "CPU" },
    { "type": "gpu", "key": "GPU" },
    { "type": "memory", "key": "MEMORY" },
    { "type": "disk", "key": "DISK", "folders": "/" },
    { "type": "battery", "key": "BATTERY" },
    { "type": "localip", "key": "LOCAL IP", "showIpv6": false },
    "break",
    { "type": "colors", "symbol": "block", "paddingLeft": 2 }
  ]
}
