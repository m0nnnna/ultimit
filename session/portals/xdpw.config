# xdg-desktop-portal-wlr: the picker shown when an app (OBS, Discord, a
# browser) asks to share the screen. fuzzel lists every monitor and every
# window, so OBS can capture a single window. Without a chooser the portal
# finds no menu program (wmenu/wofi/rofi/bemenu) and the share fails.
[screencast]
chooser_type=dmenu
chooser_cmd=fuzzel --dmenu --prompt "Share: " --width 60
